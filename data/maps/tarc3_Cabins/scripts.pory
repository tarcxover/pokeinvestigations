mapscripts tarc3_Cabins_MapScripts {
    MAP_SCRIPT_ON_LOAD: tarc3_Cabins_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TARC3_ACT1, TARC3_ACT1_NIGHT_RECAP: tarc3_Cabins_EventScript_NightRecap
        VAR_TARC3_ACT3, TARC3_ACT3_GATHERING: tarc3_Cabins_EventScript_Assembly
    ]
}

script tarc3_Cabins_OnLoad {
    setflag(FLAG_HIDE_TARC3_CABIN_TAKESHI)
    if (var(VAR_TARC3_ACT1) != TARC3_ACT1_NIGHT_RECAP) {
        setflag(FLAG_HIDE_TARC3_CABIN_RAN_NIGHT)
    }
    if (var(VAR_TARC3_ACT3) >= TARC3_ACT3_COMPLETE) {
        setflag(FLAG_HIDE_TARC3_CABIN_CAST)
        setflag(FLAG_HIDE_TARC3_CABIN_RAN)
    } elif (var(VAR_TARC3_ACT3) >= TARC3_ACT3_GATHERING) {
        clearflag(FLAG_HIDE_TARC3_CABIN_CAST)
        clearflag(FLAG_HIDE_TARC3_CABIN_RAN)
    } else {
        setflag(FLAG_HIDE_TARC3_CABIN_CAST)
        setflag(FLAG_HIDE_TARC3_CABIN_RAN)
    }
    end
}

script tarc3_Cabins_EventScript_BedroomRan {
    lock
    faceplayer
    setspeaker("{RIVAL}")
    if (var(VAR_TARC3_ACT1) < TARC3_ACT1_DEPARTED) {
        msgbox(format("Two beds, a window, a wardrobe. Adequate.\pIt is a considerable improvement on Florio."))
        msgbox(format("Go up on deck and present yourself properly.\pThese people have been generous, and you will not repay it with silence."))
        msgbox(format("I will follow once our things are put away."))
        setspeaker(NULL)
        release
        end
    }
    if (!flag(FLAG_TARC3_RAN_CABIN_TALK)) {
        setflag(FLAG_TARC3_RAN_CABIN_TALK)
        msgbox(format("There you are. The steward came past while you were wandering."))
        msgbox(format("Dinner is at seven, in the dining room. He was quite clear that we are expected."))
        msgbox(format("We will not be the ones who arrive late.\pI have no intention of beginning this voyage as an inconvenience."))
        call(tarc3_Cabins_EventScript_FamilyTree)
    } else {
        msgbox(format("Dinner. Seven o'clock.\pI will not repeat it a third time."))
    }
    setspeaker("{RIVAL}")
    msgbox(format("Are you ready to go down to the dining room?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Then continue with whatever it is you are doing.\pTell me when you are ready."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("Good. We will not keep them waiting."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setflag(FLAG_HIDE_TARC3_BEDROOM_RAN)
    setflag(FLAG_HIDE_TARC3_MAINDECK_MARIKO)
    setflag(FLAG_HIDE_TARC3_MAINDECK_AKIE)
    setflag(FLAG_HIDE_TARC3_MAINDECK_SUZUKI)
    setflag(FLAG_HIDE_TARC3_MAINDECK_JOJI)
    setflag(FLAG_HIDE_TARC3_FOREDECK_GUESTS)
    clearflag(FLAG_HIDE_TARC3_DINING_SUZUKI)
    clearflag(FLAG_HIDE_TARC3_DINING_JOJI)
    clearflag(FLAG_HIDE_TARC3_DINING_NATSUE)
    clearflag(FLAG_HIDE_TARC3_DINING_MARIKO)
    clearflag(FLAG_HIDE_TARC3_DINING_KITARO)
    clearflag(FLAG_HIDE_TARC3_DINING_AKIE)
    clearflag(FLAG_HIDE_TARC3_DINING_TATSUO)
    clearflag(FLAG_HIDE_TARC3_DINING_ICHIRO)
    clearflag(FLAG_HIDE_TARC3_DINING_RAN)
    setvar(VAR_TARC3_ACT1, TARC3_ACT1_DINNER)
    warp(MAP_TARC3_MAIN_DECK, 41, 12)
    waitstate
    end
}

script tarc3_Cabins_EventScript_FamilyTree {
    setspeaker("{RIVAL}")
    msgbox(format("Before we sit at their table, I will have this family straight."))
    msgbox(format("Gozo Hatamoto is the head of it.\pEvery other person aboard is a child of his, a grandchild, or married in."))
    msgbox(format("Natsue and Akie are the granddaughters.\pTheir father Shoichi was the eldest son. He and their mother died last year."))
    msgbox(format("Mariko is the eldest daughter. Kitaro is her husband, and runs one of the family companies.\pJoji is the second son. The chef."))
    msgbox(format("Then the two who married in.\pTakeshi to Natsue this morning. Tatsuo to Akie."))
    msgbox(format("And Ichiro, who fits nowhere in it.\pHe came for the wedding and he is not a Hatamoto. A loose end."))
    msgbox(format("Nine in the wedding party, the steward, and the two of us.\pTwelve. And the crew stay in their own quarters."))
    setspeaker(NULL)
    closemessage
    return
}

// INVESTIGATION - the cabin search
// (active while VAR_TARC3_ACT2 = TARC3_ACT2_SEARCH_TAKESHI)

script tarc3_Cabins_EventScript_EvdKnifeRoll {
    lockall
    goto_if_set(FLAG_TARC3_CABIN_FOUND_KNIVES, tarc3_Cabins_EventScript_EvdKnifeRollSeen)
    msgbox(format("Joji's custom-made travel bag. A knife roll lies on top, with space for eight blades stitched into the canvas."))
    msgbox(format("Two of them are empty."))
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}One turned up beside Ichiro. So where is the other one?", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_MISSING_KNIVES)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}There's a dark smear on the inside of the flap.", "1_latin_rse_narrow"))
    closemessage
    // EVD_RESIDUE_ON_CASE cut
    closemessage
    setflag(FLAG_TARC3_CABIN_FOUND_KNIVES)
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdKnifeRollSeen {
    msgbox(format("Joji's knife roll. Two missing knives, and a dark smear on the inside."))
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdResignation {
    lockall
    goto_if_set(FLAG_TARC3_CABIN_FOUND_RESIGNATION, tarc3_Cabins_EventScript_EvdResignationSeen)
    msgbox(format("A folder of Corporation papers, squared off on the desk."))
    msgbox(format("One document details a project that is running significantly behind schedule.\pA comment in red ink reads 'Gozo is furious. Please fix.'"))
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}Kitaro appears to be under significant pressure at work.\p", "1_latin_rse_narrow"))
    closemessage
    // EVD_RESIGNATION_NOTE cut
    closemessage
    setflag(FLAG_TARC3_CABIN_FOUND_RESIGNATION)
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdResignationSeen {
    msgbox(format("Documents showing delayed projects and forecasts not being met.'"))
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdSketchbook {
    lockall
    goto_if_set(FLAG_TARC3_CABIN_FOUND_SKETCHBOOK, tarc3_Cabins_EventScript_EvdSketchbookSeen)
    msgbox(format("It appears to be Ichiro's sketchbook."))
    closemessage
    delay(20)
    msgbox(format("There are dozens of charcoal sketches in here, with a variety of subjects.\pPokémon, landscapes, people..."))
    closemessage
    delay(20)
    playse(SE_PIN)
    applymovement(LOCALID_CABINS_TAKESHI_CLOSET, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    msgbox(format("{FONT_NARROW}There's a section of the book dedicated to the same girl.\pNatsue.", "1_latin_rse_narrow"))
    closemessage
    delay(20)
    msgbox(format("The last page is dated today.\pNatsue on the island, in her wedding dress, drawn from a distance."))
    closemessage
    giveevidence(EVD_SKETCHBOOK)
    closemessage
    setflag(FLAG_TARC3_CABIN_FOUND_SKETCHBOOK)
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdSketchbookSeen {
    msgbox(format("Ichiro's sketchbook. A whole section of it is Natsue."))
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdSupplies {
    lockall
    goto_if_set(FLAG_TARC3_CABIN_FOUND_SUPPLIES, tarc3_Cabins_EventScript_EvdSuppliesSeen)
    msgbox(format("A bag of art supplies. Sticks of charcoal, a sharpener, and a can of fixative."))
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}These must be Ichiro's sketching supplies.", "1_latin_rse_narrow"))
    closemessage
    // EVD_CHARCOAL_SUPPLIES cut
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}There's also a torn end of bread with dark smudges. Is this being used as an eraser?", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_BREAD_ERASER)
    closemessage
    setflag(FLAG_TARC3_CABIN_FOUND_SUPPLIES)
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdSuppliesSeen {
    msgbox(format("Charcoal and a torn end of bread."))
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdEnvelope {
    lockall
    goto_if_set(FLAG_TARC3_CABIN_FOUND_ENVELOPE, tarc3_Cabins_EventScript_EvdEnvelopeSeen)
    msgbox(format("A torn envelope on the desk, Corporation letterhead.\pThe untorn half reads 'FINAL WISHES O...'."))
    msgbox(format("{FONT_NARROW}She knew there was a will before Suzuki opened his mouth downstairs.", "1_latin_rse_narrow"))
    closemessage
    // EVD_WILL_CORRESPONDENCE cut
    closemessage
    setflag(FLAG_TARC3_CABIN_FOUND_ENVELOPE)
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdEnvelopeSeen {
    msgbox(format("A torn envelope, once containing some form of Gozo's will."))
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdPicture {
    lockall
    goto_if_set(FLAG_TARC3_CABIN_FOUND_PICTURE, tarc3_Cabins_EventScript_EvdPictureSeen)
    msgbox(format("A framed photograph hung on the wall.\pIt features a proud man and a younger boy, standing in front of a building."))
    msgbox(format("{FONT_NARROW}Zaiki Research Institute is on a sign outside the building.\pThis must be Takeshi and his father.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_FAMILY_PICTURE)
    closemessage
    setflag(FLAG_TARC3_CABIN_FOUND_PICTURE)
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdPictureSeen {
    msgbox(format("A photo of Takeshi and his father outside the Zaiki Research Institute."))
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdCloset {
    lockall
    goto_if_set(FLAG_TARC3_CABIN_FOUND_TAKESHI, tarc3_Cabins_EventScript_EvdClosetSeen)
    msgbox(format("A tall closet against the back wall. The door is slightly ajar."))
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}...Something in there is breathing.", "1_latin_rse_narrow"))
    closemessage
    delay(30)
    playse(SE_DOOR)
    clearflag(FLAG_HIDE_TARC3_CABIN_TAKESHI)
    addobject(LOCALID_CABINS_TAKESHI_CLOSET)
    delay(30)
    playse(SE_PIN)
    applymovement(LOCALID_CABINS_TAKESHI_CLOSET, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    setspeaker("Takeshi")
    msgbox(format("Is it safe?\pDon't call them.\pI... I'm not a killer. I can tell you everything."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Takeshi")
    msgbox(format("I didn't escape the cell on my own. I didn't even hear the door unlock.\pI just heard my door slowly creak open while someone rushed up the stairs."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}He didn't open it. Somebody let him out without a word.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_UNLOCKED_CELL)
    closemessage
    delay(20)
    setvar(VAR_TEMP_4, 0)
    setvar(VAR_TEMP_5, 0)
    setvar(VAR_TEMP_6, 0)
    goto(tarc3_Cabins_EventScript_EvdClosetTopics)
}

script tarc3_Cabins_EventScript_EvdClosetTopics {
    if (var(VAR_TEMP_4) == 1 && var(VAR_TEMP_5) == 1 && var(VAR_TEMP_6) == 1) {
        goto(tarc3_Cabins_EventScript_EvdClosetTopicsEnd)
    }
    setspeaker(NULL)
    message(format("(What do I still need to hear from him?)"))
    waitmessage
    if (var(VAR_TEMP_4) == 0) {
        dynmultipush("Your escape", 1)
    }
    if (var(VAR_TEMP_5) == 0) {
        dynmultipush("Your garland", 2)
    }
    if (var(VAR_TEMP_6) == 0) {
        dynmultipush("Gozo conversation", 3)
    }
    dynmultistack(0, 0, TRUE, 3, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 1:
            goto(tarc3_Cabins_EventScript_EvdClosetEscape)
        case 2:
            goto(tarc3_Cabins_EventScript_EvdClosetGarland)
        case 3:
            goto(tarc3_Cabins_EventScript_EvdClosetGozo)
        default:
            goto(tarc3_Cabins_EventScript_EvdClosetTopics)
    }
}

script tarc3_Cabins_EventScript_EvdClosetEscape {
    setvar(VAR_TEMP_4, 1)
    setspeaker("Takeshi")
    msgbox(format("Once I could leave, I went up to find Natsue. That's all I wanted."))
    msgbox(format("But everyone was rushing towards the deck door. I needed to hide."))
    msgbox(format("The first unlocked door I found was this one."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}Straight into the first open cabin. He never had time to plan a thing.", "1_latin_rse_narrow"))
    closemessage
    delay(20)
    goto(tarc3_Cabins_EventScript_EvdClosetTopics)
}

script tarc3_Cabins_EventScript_EvdClosetGarland {
    setvar(VAR_TEMP_5, 1)
    setspeaker("Takeshi")
    msgbox(format("I last had the garland on the salon deck. Before Gozo called me in."))
    msgbox(format("Ichiro asked me about it.\pHe wanted to know where the flower came from."))
    msgbox(format("He leaned in close enough to look at it. I remember, because he hardly ever starts a conversation."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}The last person to put a hand near that flower, and then it turns up outside a dead man's door.", "1_latin_rse_narrow"))
    closemessage
    // EVD_GARLAND_PROVENANCE cut
    closemessage
    delay(20)
    goto(tarc3_Cabins_EventScript_EvdClosetTopics)
}

script tarc3_Cabins_EventScript_EvdClosetGozo {
    setvar(VAR_TEMP_6, 1)
    setspeaker("Takeshi")
    msgbox(format("Gozo said he had known who I was for months, and let the wedding go ahead anyway."))
    msgbox(format("I told him the truth. That my plan had been to ruin him...\pAnd that I gave it up.\pThat I love her."))
    msgbox(format("He said he knew. That's why he chose me."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}Mariko stood outside that door and heard all of it. But she repeated only the first half to the room.", "1_latin_rse_narrow"))
    closemessage
    // EVD_WITHHELD_HALF cut
    closemessage
    delay(20)
    goto(tarc3_Cabins_EventScript_EvdClosetTopics)
}

script tarc3_Cabins_EventScript_EvdClosetTopicsEnd {
    setspeaker("Takeshi")
    msgbox(format("They won't listen to me. You saw them. You... You believe me, right?"))
    msgbox(format("I'll stay here. You need to prove my innocence and reveal who the killer is!"))
    closemessage
    delay(20)
    applymovement(LOCALID_CABINS_TAKESHI_CLOSET, moves(walk_in_place_slow_down))
    waitmovement(0)
    setspeaker("Takeshi")
    msgbox(format("...Thank you."))
    setspeaker(NULL)
    closemessage
    delay(20)
    playse(SE_DOOR)
    setflag(FLAG_HIDE_TARC3_CABIN_TAKESHI)
    removeobject(LOCALID_CABINS_TAKESHI_CLOSET)
    delay(30)
    setflag(FLAG_TARC3_CABIN_FOUND_TAKESHI)
    msgbox(format("{FONT_NARROW}Now that I know where Takeshi is, I should prepare to make my accusation.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}I will tell {RIVAL} when I am ready. Every one of them must be in the same room.", "1_latin_rse_narrow"))
    closemessage
    releaseall
    end
}

script tarc3_Cabins_EventScript_EvdClosetSeen {
    msgbox(format("The closet door. Takeshi is still in here."))
    releaseall
    end
}

// ACT THREE - the family assembles in Akie's cabin (CS11)
// triggers via tarc3_MainDeck_EventScript_DiningRan

script tarc3_Cabins_EventScript_Assembly {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovement(0)
    delay(30)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_up))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_CABINS_RAN, moves(face_left))
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("That is all of them. Nobody is to be left alone."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_CABINS_MARIKO, moves(face_right))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("Say whatever it is you brought us here to say."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_CABINS_SUZUKI, moves(walk_in_place_slow_down))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("Let him speak, Mariko.\pHe has been the sole person on this ship trying to make sense of this tragedy."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_CABINS_ICHIRO, moves(walk_in_place_slow_down))
    waitmovement(0)
    setspeaker("Ichiro")
    msgbox(format("Ugh... My leg. Did you really need me here?"))
    setspeaker(NULL)
    closemessage
    delay(30)
    setspeaker("{RIVAL}")
    msgbox(format("{PLAYER} Edgeworth required every one of you in a single room.\pYou will stand there, and you will listen."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}I should talk to {RIVAL} when I'm ready to begin.", "1_latin_rse_narrow"))
    closemessage
    delay(20)
    applymovement(LOCALID_CAMERA, moves(walk_down))
    waitmovement(0)
    special(RemoveCameraObject)
    setvar(VAR_TARC3_ACT3, TARC3_ACT3_ASSEMBLED)
    releaseall
    end
}

script tarc3_Cabins_EventScript_GatherNoExit {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up))
    waitmovement(0)
    releaseall
    end
}

script tarc3_Cabins_EventScript_GatherRan {
    lock
    faceplayer
    setspeaker("{RIVAL}")
    msgbox(format("Every one of them is here, and every one of them is listening."))
    msgbox(format("Once you begin, you do not stop to go and verify something.\pAre you ready?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Then go back over it. I will keep them standing."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("Then begin."))
    setspeaker(NULL)
    closemessage
    msgbox(format("{COLOR RED}IMPORTANT:{COLOR DARK_GRAY} This will begin the final cutscene of the game.\pYou may want to save. Would you like to save now?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        call(Common_EventScript_SaveGame)
    }
    closemessage
    release
    goto(tarc3_Accusation_EventScript_Begin)
}

script tarc3_Cabins_EventScript_GatherMariko {
    lock
    faceplayer
    setspeaker("Mariko")
    msgbox(format("We are all standing here. Get on with it."))
    setspeaker(NULL)
    release
    end
}

script tarc3_Cabins_EventScript_GatherSuzuki {
    lock
    faceplayer
    setspeaker("Suzuki")
    msgbox(format("Whatever you have found, say it plainly."))
    setspeaker(NULL)
    release
    end
}

script tarc3_Cabins_EventScript_GatherNatsue {
    lock
    faceplayer
    setspeaker("Natsue")
    msgbox(format("You've pieced together what happened.\pI trust you."))
    setspeaker(NULL)
    release
    end
}

script tarc3_Cabins_EventScript_GatherAkie {
    lock
    faceplayer
    setspeaker("Akie")
    msgbox(format("The last time I was in this room... I was arguing with Tatsuo. I just want this to be over."))
    setspeaker(NULL)
    release
    end
}

script tarc3_Cabins_EventScript_GatherKitaro {
    lock
    faceplayer
    setspeaker("Kitaro")
    msgbox(format("If you've worked it out, I would rather hear it than keep guessing."))
    setspeaker(NULL)
    release
    end
}

script tarc3_Cabins_EventScript_GatherJoji {
    lock
    faceplayer
    setspeaker("Joji")
    msgbox(format("Go on. I'd like the truth. I know I am implicated... But I am innocent."))
    setspeaker(NULL)
    release
    end
}

script tarc3_Cabins_EventScript_GatherIchiro {
    lock
    faceplayer
    setspeaker("Ichiro")
    msgbox(format("You went through our cabins, didn't you."))
    setspeaker(NULL)
    release
    end
}


// CS6b - the recap in the player's cabin, before the night investigation

script tarc3_Cabins_EventScript_NightRecap {
    lockall
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
    waitmovement(0)
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("They have locked a man in a storage room on the strength of a single flower.\pThat is not evidence. That is a mob grown tired of thinking."))
    msgbox(format("Take a moment to think about what we've witnessed thus far."))
    setspeaker(NULL)
    closemessage
    call(tarc3_Cabins_EventScript_RecapCS5)
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("Good. Now put it somewhere it will keep.\pA fact you cannot find again is a fact you do not have."))
    setspeaker(NULL)
    closemessage
    delay(20)
    call(tarc3_Cabins_EventScript_NightGarland)
    delay(20)
    call(tarc3_Cabins_EventScript_NotebookPrimer)
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("Read back over what you are carrying, and then go and speak to that family.\pThey are still awake. They will not be honest, but they will be talkative."))
    msgbox(format("I am going to find Natsue.\pSomebody ought to be with her, and plainly, it will not be any of them."))
    msgbox(format("We will be at the door out to the deck. Come and find us when you are finished."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_CABINS_RAN_NIGHT, moves(walk_up * 2))
    waitmovement(0)
    delay(10)
    opendoor(50, 17)
    waitdooranim
    applymovement(LOCALID_CABINS_RAN_NIGHT, moves(walk_up))
    waitmovement(0)
    removeobject(LOCALID_CABINS_RAN_NIGHT)
    setflag(FLAG_HIDE_TARC3_CABIN_RAN_NIGHT)
    closedoor(50, 17)
    waitdooranim
    delay(30)
    clearflag(FLAG_HIDE_TARC3_NIGHT_CAST)
    clearflag(FLAG_HIDE_TARC3_NIGHT_ICHIRO)
    clearflag(FLAG_HIDE_TARC3_DECKDOOR_CAST)
    setflag(FLAG_HIDE_TARC3_NIGHT_MONS)
    setvar(VAR_TARC3_ACT1, TARC3_ACT1_NIGHT_ROAM)
    releaseall
    end
}

script tarc3_Cabins_EventScript_NightGarland {
    checkevidence(EVD_DROPPED_FLOWER)
    goto_if_eq(VAR_RESULT, TRUE, tarc3_Cabins_EventScript_NightGarlandHeld)
    setspeaker("{RIVAL}")
    msgbox(format("And one thing nobody in that room disputed.\pMariko said it out loud, in front of all of them."))
    msgbox(format("The garland was lying in the corridor, a step from his door, before any of them knew he was dead."))
    setspeaker(NULL)
    closemessage
    giveevidence(EVD_DROPPED_FLOWER)
    closemessage
    return
}

script tarc3_Cabins_EventScript_NightGarlandHeld {
    setspeaker("{RIVAL}")
    msgbox(format("You already have the garland written down. Good.\pThat, and the meeting Gozo demanded of Takeshi."))
    setspeaker(NULL)
    closemessage
    return
}

script tarc3_Cabins_EventScript_NotebookPrimer {
    setspeaker(NULL)
    msgbox(format("Press {START_BUTTON} and choose Evidence to review what {PLAYER} is carrying."))
    msgbox(format("Highlight one piece with {A_BUTTON}, then a second, and press {START_BUTTON} to deduce.\pA pair that fits becomes a new, stronger conclusion."))
    msgbox(format("Try Requested Meeting together with Dropped Flower."))
    closemessage
    return
}
// CS6 recap - the reflections on what was said in CS5 and CS6

script tarc3_Cabins_EventScript_RecapCS5 {
    goto_if_set(FLAG_TARC3_REFLECT_HOLD_CS5, tarc3_Cabins_EventScript_RecapEnd)
    call(tarc3_Cabins_EventScript_RecapName)
    call(tarc3_Cabins_EventScript_RecapArgument)
    call(tarc3_Cabins_EventScript_RecapWill)
    call(tarc3_Cabins_EventScript_RecapBolt)
    setflag(FLAG_TARC3_REFLECT_HOLD_CS5)
    goto(tarc3_Cabins_EventScript_RecapEnd)
}

script tarc3_Cabins_EventScript_RecapName {
    setspeaker(NULL)
    message(format("{FONT_NARROW}Mariko put all of it in the open upstairs. What was worth keeping?", "1_latin_rse_narrow"))
    waitmessage
    dynmultipush("Natsue walked out", 2)
    dynmultipush("Takeshi's family name is Zaiki", 1)
    dynmultipush("Mariko wants him locked away", 3)
    dynmultistack(0, 0, TRUE, 3, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 1:
            goto(tarc3_Cabins_EventScript_RecapNameRight)
        default:
            goto(tarc3_Cabins_EventScript_RecapNameWrong)
    }
}

script tarc3_Cabins_EventScript_RecapNameRight {
    msgbox(format("{FONT_NARROW}Gozo took his father's company and the man killed himself over it.\pTakeshi married into the family that did it.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_TAKESHIS_HISTORY)
    closemessage
    return
}

script tarc3_Cabins_EventScript_RecapNameWrong {
    msgbox(format("{FONT_NARROW}I'd have walked out too. It doesn't tell me anything.", "1_latin_rse_narrow"))
    closemessage
    return
}

script tarc3_Cabins_EventScript_RecapArgument {
    setspeaker(NULL)
    message(format("{FONT_NARROW}And what does she claim she heard, standing at that door?", "1_latin_rse_narrow"))
    waitmessage
    dynmultipush("His name, shouted through it", 1)
    dynmultipush("Nothing at all", 3)
    dynmultipush("A struggle inside the cabin", 2)
    dynmultistack(0, 0, TRUE, 3, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 1:
            goto(tarc3_Cabins_EventScript_RecapArgumentRight)
        default:
            goto(tarc3_Cabins_EventScript_RecapArgumentWrong)
    }
}

script tarc3_Cabins_EventScript_RecapArgumentRight {
    msgbox(format("{FONT_NARROW}She stood at that door before dinner and heard her father shouting Takeshi's name.\pSo she says.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_OVERHEARD_ARGUMENT)
    closemessage
    return
}

script tarc3_Cabins_EventScript_RecapArgumentWrong {
    msgbox(format("{FONT_NARROW}No. A raised voice and a name, and nothing beyond that.\pI will not improve on her account for her.", "1_latin_rse_narrow"))
    closemessage
    return
}

script tarc3_Cabins_EventScript_RecapWill {
    setspeaker(NULL)
    message(format("{FONT_NARROW}Then Suzuki chose that moment to read out the will. Who does it favour?", "1_latin_rse_narrow"))
    waitmessage
    dynmultipush("The Corporation, not the family", 3)
    dynmultipush("Mariko, as the eldest", 2)
    dynmultipush("Natsue, and the man she chose", 1)
    dynmultistack(0, 0, TRUE, 3, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 1:
            goto(tarc3_Cabins_EventScript_RecapWillRight)
        default:
            goto(tarc3_Cabins_EventScript_RecapWillWrong)
    }
}

script tarc3_Cabins_EventScript_RecapWillRight {
    msgbox(format("{FONT_NARROW}Everything to Natsue, and her husband at the head of the Corporation.\pTakeshi was handed a motive in front of seven witnesses.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}And so was every one of them, the moment they understood what they had lost.", "1_latin_rse_narrow"))
    closemessage
    return
}

script tarc3_Cabins_EventScript_RecapWillWrong {
    msgbox(format("{FONT_NARROW}That is not what was read out. If I cannot keep the terms straight, I have no business using them.", "1_latin_rse_narrow"))
    closemessage
    return
}

script tarc3_Cabins_EventScript_RecapBolt {
    setspeaker(NULL)
    message(format("{FONT_NARROW}One more. That door Suzuki bolted behind him.", "1_latin_rse_narrow"))
    waitmessage
    dynmultipush("Suzuki holds the only key", 2)
    dynmultipush("It only opens from out here", 1)
    dynmultipush("Takeshi bolted it himself", 3)
    dynmultistack(0, 0, TRUE, 3, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 1:
            goto(tarc3_Cabins_EventScript_RecapBoltRight)
        default:
            goto(tarc3_Cabins_EventScript_RecapBoltWrong)
    }
}

script tarc3_Cabins_EventScript_RecapBoltRight {
    msgbox(format("{FONT_NARROW}No handle on the inside. He cannot open that door and he cannot close it.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}So if it is ever found standing open, somebody on this side of it opened it.", "1_latin_rse_narrow"))
    closemessage
    return
}

script tarc3_Cabins_EventScript_RecapBoltWrong {
    msgbox(format("{FONT_NARROW}There is no lock and there is no key. It is a bolt, and it is on this side of the door.", "1_latin_rse_narrow"))
    closemessage
    return
}

script tarc3_Cabins_EventScript_RecapEnd {
    return
}
