mapscripts tarc3_ElectricalRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD: tarc3_ElectricalRoom_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TARC3_ACT2, TARC3_ACT2_TO_ELECTRICAL: tarc3_ElectricalRoom_EventScript_Breakers
    ]
}

script tarc3_ElectricalRoom_OnLoad {
    if (var(VAR_TARC3_ACT2) == TARC3_ACT2_TO_ELECTRICAL) {
        clearflag(FLAG_HIDE_TARC3_ELEC_CAST)
    } else {
        setflag(FLAG_HIDE_TARC3_ELEC_CAST)
    }
    end
}

// CS10

script tarc3_ElectricalRoom_EventScript_Breakers {
    lockall
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right * 2, walk_down * 5, walk_left * 3, walk_up, walk_left, face_up))
    waitmovement(0)
    delay(20)
    setspeaker("Suzuki")
    msgbox(format("This is the main breaker."))
    msgbox(format("I found it tripped, so I put it back."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_ELEC_SUZUKI, moves(emote_question_mark))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("This ship is twenty years old. This could just be an accident."))
    msgbox(format("Nobody may have touched anything.\pShe is simply old."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Kitaro")
    msgbox(format("Breakers trip when something draws too much power.\pIt would have tripped again if the fault happened again."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}...There's scorching around the switch housing.", "1_latin_rse_narrow"))
    closemessage
    delay(20)
    applymovement(LOCALID_ELEC_MARIKO, moves(face_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("Then somebody was standing down here."))
    msgbox(format("And the rest of us were at that table."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Suzuki")
    msgbox(format("It could have been any of us, Mariko.\pOr none of us."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Suzuki")
    msgbox(format("{PLAYER}. After you finish your inspection here, help me find Takeshi upstairs.\p"))
    msgbox(format("The rest of you, go back to the dining room.\pStay together, and stay where I can find you."))
    setspeaker(NULL)
    closemessage
    delay(20)
    fadescreen(FADE_TO_BLACK)
    setflag(FLAG_HIDE_TARC3_ELEC_CAST)
    removeobject(LOCALID_ELEC_SUZUKI)
    removeobject(LOCALID_ELEC_JOJI)
    removeobject(LOCALID_ELEC_KITARO)
    removeobject(LOCALID_ELEC_MARIKO)
    removeobject(LOCALID_ELEC_AKIE)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_SEARCH_TAKESHI)
    fadescreen(FADE_FROM_BLACK)
    delay(20)
    releaseall
    end
}

script tarc3_ElectricalRoom_EventScript_Breaker {
    lockall
    goto_if_set(FLAG_TARC3_ELEC_FOUND_PANEL, tarc3_ElectricalRoom_EventScript_BreakerSeen)
    msgbox(format("The scorching around the switch housing is blistered outward, not inward."))
    msgbox(format("{FONT_NARROW}Nothing inside this panel burned out. The heat arrived from the room.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_SCORCHED_PANEL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}And Suzuki merely suggested it's just because the ship is twenty years old?", "1_latin_rse_narrow"))
    closemessage
    // EVD_OLD_WIRING cut
    closemessage
    setflag(FLAG_TARC3_ELEC_FOUND_PANEL)
    releaseall
    end
}

script tarc3_ElectricalRoom_EventScript_BreakerSeen {
    msgbox(format("Scorched around the switch housing, and blistered outward."))
    releaseall
    end
}

script tarc3_ElectricalRoom_EventScript_EvdBin {
    lockall
    if (var(VAR_TARC3_ACT2) < TARC3_ACT2_SEARCH_TAKESHI) {
        msgbox(format("A waste bin beside the breaker housing."))
        releaseall
        end
    }
    goto_if_set(FLAG_TARC3_ELEC_FOUND_LATCH, tarc3_ElectricalRoom_EventScript_EvdBinSeen)
    msgbox(format("A waste bin beside the breaker housing. There is something metal inside it."))
    msgbox(format("{FONT_NARROW}A latch, snapped clean off. The screws are still in the housing.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_BROKEN_LATCH)
    closemessage
    setflag(FLAG_TARC3_ELEC_FOUND_LATCH)
    releaseall
    end
}

script tarc3_ElectricalRoom_EventScript_EvdBinSeen {
    msgbox(format("The breaker's latch, snapped off and thrown away."))
    releaseall
    end
}
