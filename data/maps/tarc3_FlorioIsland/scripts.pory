mapscripts tarc3_FlorioIsland_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TARC3_FLORIO_INTRO, 4: tarc3_FlorioIsland_EventScript_HidePlayerForDeparture
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TARC3_FLORIO_INTRO, 0: tarc3_FlorioIsland_EventScript_OpeningCutscene
        VAR_TARC3_FLORIO_INTRO, 4: tarc3_FlorioIsland_EventScript_ShipDeparts
    ]
}

script tarc3_FlorioIsland_EventScript_HidePlayerForDeparture {
    hideplayer
    end
}

script tarc3_FlorioIsland_EventScript_OpeningCutscene {
    lockall
    setflag(FLAG_SYS_POKEMON_GET)
    givemon(SPECIES_BISHARP, 50, ball=ITEM_POKE_BALL, nature=NATURE_HARDY, abilityNum=1, hpIv=31, atkIv=31, defIv=31, speedIv=31, spAtkIv=31, spDefIv=31, move1=MOVE_NIGHT_SLASH, move2=MOVE_IRON_HEAD, move3=MOVE_RETALIATE, move4=MOVE_ASSURANCE)
    setflag(FLAG_BADGE01_GET)
    setflag(FLAG_BADGE02_GET)
    setflag(FLAG_BADGE03_GET)
    setflag(FLAG_BADGE04_GET)
    setflag(FLAG_BADGE05_GET)
    setflag(FLAG_BADGE06_GET)
    setflag(FLAG_BADGE07_GET)
    setflag(FLAG_BADGE08_GET)
    delay(30)
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("{PLAYER} Edgeworth. Tell me that is not our ferry."))
    setspeaker(NULL)
    closemessage
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_faster_down * 15))
    waitmovement(0)
    delay(30)
    playse(SE_SHIP)
    applymovement(LOCALID_FLORIO_SSHANA, tarc3_FlorioIsland_Movement_ShipDeparts)
    waitmovement(0)
    setflag(FLAG_HIDE_TARC3_FLORIO_SSHANA)
    removeobject(LOCALID_FLORIO_SSHANA)
    delay(30)
    applymovement(LOCALID_CAMERA, moves(walk_faster_up * 15))
    waitmovement(0)
    special(RemoveCameraObject)
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("Gone.\pAnd not another until tomorrow. An entire day, surrendered to a timetable."))
    setspeaker(NULL)
    msgbox(format("{FONT_NARROW}No passage home, then.\pThere will be another way off this island. I'm sure of it.", "1_latin_rse_narrow"))
    setspeaker("{RIVAL}")
    msgbox(format("You have spoken of nothing but this island's Pokémon since dawn.\pGo. Look at them."))
    msgbox(format("I will secure us passage myself. It is hardly a difficult problem.\pPresent yourself at the dock when you have finished amusing yourself."))
    setspeaker(NULL)
    msgbox(format("{FONT_NARROW}{RIVAL} has taken charge of transport procurement.\pAnd I have yet to catch a single Pokémon.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}She won't afford me any luxuries. One is all I will have time for.\pI had best choose well.", "1_latin_rse_narrow"))
    closemessage
    applymovement(LOCALID_FLORIO_RAN_1, moves(walk_down * 7))
    waitmovement(0)
    setflag(FLAG_HIDE_TARC3_FLORIO_RAN)
    removeobject(LOCALID_FLORIO_RAN_1)
    delay(20)
    updatefollowingmon
    setvar(VAR_TARC3_FLORIO_INTRO, 1)
    releaseall
    end
}

script tarc3_FlorioIsland_EventScript_CatchStoutland {
    lock
    faceplayer
    playmoncry(SPECIES_STOUTLAND, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("A Stoutland lifts its head and works the air, then pads straight over.\pIt found {PLAYER} before {PLAYER} found it.\pAdd Stoutland to the party?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("The Stoutland settles back onto the grass."))
        release
        end
    }
    givemon(SPECIES_STOUTLAND, 50, ball=ITEM_POKE_BALL, nature=NATURE_HARDY, abilityNum=0, hpIv=20, atkIv=20, defIv=20, speedIv=20, spAtkIv=20, spDefIv=20, move1=MOVE_BODY_SLAM, move2=MOVE_CRUNCH, move3=MOVE_PLAY_ROUGH, move4=MOVE_ODOR_SLEUTH)
    playfanfare(MUS_CAUGHT)
    msgbox(format("{PLAYER} added Stoutland to the party!"))
    waitfanfare
    setflag(FLAG_HIDE_TARC3_FLORIO_STOUTLAND)
    removeobject(LOCALID_FLORIO_STOUTLAND)
    goto(tarc3_FlorioIsland_EventScript_AfterCatch)
}

script tarc3_FlorioIsland_EventScript_CatchMagnezone {
    lock
    faceplayer
    playmoncry(SPECIES_MAGNEZONE, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("A Magnezone studies {PLAYER} with a single, unblinking eye.\pAdd Magnezone to the party?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("The Magnezone hums."))
        release
        end
    }
    givemon(SPECIES_MAGNEZONE, 50, ball=ITEM_POKE_BALL, nature=NATURE_HARDY, abilityNum=0, hpIv=20, atkIv=20, defIv=20, speedIv=20, spAtkIv=20, spDefIv=20, move1=MOVE_THUNDERBOLT, move2=MOVE_FLASH_CANNON, move3=MOVE_THUNDER_WAVE, move4=MOVE_FLASH)
    playfanfare(MUS_CAUGHT)
    msgbox(format("{PLAYER} added Magnezone to the party!"))
    waitfanfare
    setflag(FLAG_HIDE_TARC3_FLORIO_MAGNEZONE)
    removeobject(LOCALID_FLORIO_MAGNEZONE)
    goto(tarc3_FlorioIsland_EventScript_AfterCatch)
}

script tarc3_FlorioIsland_EventScript_CatchCramorant {
    lock
    faceplayer
    playmoncry(SPECIES_CRAMORANT, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("A Cramorant retreats up the path, then stops.\pIt tilts its head at {PLAYER}, and does not run again.\pAdd Cramorant to the party?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("The Cramorant caws indignantly."))
        playmoncry(SPECIES_CRAMORANT, CRY_MODE_ENCOUNTER)
        waitmoncry
        release
        end
    }
    givemon(SPECIES_CRAMORANT, 50, ball=ITEM_POKE_BALL, nature=NATURE_HARDY, abilityNum=0, hpIv=20, atkIv=20, defIv=20, speedIv=20, spAtkIv=20, spDefIv=20, move1=MOVE_SURF, move2=MOVE_DRILL_PECK, move3=MOVE_ROOST, move4=MOVE_DIVE)
    playfanfare(MUS_CAUGHT)
    msgbox(format("{PLAYER} added Cramorant to the party!"))
    waitfanfare
    setflag(FLAG_HIDE_TARC3_FLORIO_CRAMORANT)
    removeobject(LOCALID_FLORIO_CRAMORANT)
    goto(tarc3_FlorioIsland_EventScript_AfterCatch)
}

script tarc3_FlorioIsland_EventScript_AfterCatch {
    msgbox(format("{FONT_NARROW}One companion, and no time for any more.\pI best return to {RIVAL} now, she will not thank me for keeping her waiting at the dock.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_HIDE_TARC3_FLORIO_STOUTLAND)
    setflag(FLAG_HIDE_TARC3_FLORIO_MAGNEZONE)
    setflag(FLAG_HIDE_TARC3_FLORIO_CRAMORANT)
    removeobject(LOCALID_FLORIO_STOUTLAND)
    removeobject(LOCALID_FLORIO_MAGNEZONE)
    removeobject(LOCALID_FLORIO_CRAMORANT)
    setobjectxyperm(LOCALID_FLORIO_RAN_1, 17, 34)
    setobjectmovementtype(LOCALID_FLORIO_RAN_1, MOVEMENT_TYPE_FACE_LEFT)
    setobjectmovementtype(LOCALID_FLORIO_NATSUE, MOVEMENT_TYPE_FACE_RIGHT)
    clearflag(FLAG_HIDE_TARC3_FLORIO_RAN)
    setvar(VAR_TARC3_FLORIO_INTRO, 2)
    release
    end
}

script tarc3_FlorioIsland_EventScript_DockBlock {
    lockall
    if (var(VAR_TARC3_FLORIO_INTRO) == 1) {
        msgbox(format("{FONT_NARROW}{RIVAL} is still negotiating our passage.\pI may as well make a proper survey of the island while she does.", "1_latin_rse_narrow"))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up))
        waitmovement(0)
        releaseall
        end
    }
    if (var(VAR_TARC3_FLORIO_INTRO) == 2) {
        goto(tarc3_FlorioIsland_EventScript_NatsueInvitation)
    }
    releaseall
    end
}

script tarc3_FlorioIsland_EventScript_NatsueInvitation {
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_FLORIO_RAN_1, moves(walk_up))
    applymovement(LOCALID_FLORIO_NATSUE, moves(walk_up))
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("There you are.\pI was one minute from sending that dockhand up the hill to retrieve you."))
    msgbox(format("This is Natsue.\pShe has made us an offer with regards to our passage home."))
    setspeaker("Natsue")
    msgbox(format("Please, travel with us.\pThat's our ship at the end of the pier. The SS Hana."))
    msgbox(format("She's a private charter.\pThere's more room aboard than we know what to do with. It's no trouble at all."))
    applymovement(LOCALID_FLORIO_RAN_1, moves(face_left))
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("You understand that you are offering passage to two complete strangers."))
    applymovement(LOCALID_FLORIO_NATSUE, moves(face_right))
    waitmovement(0)
    setspeaker("Natsue")
    msgbox(format("I'd feel far worse leaving you on an empty pier.\pPlease."))
    setspeaker("{RIVAL}")
    msgbox(format("...Then we accept.\pI do not care to be in anyone's debt, Natsue. Consider it one I intend to settle."))
    setspeaker("Natsue")
    msgbox(format("I'll have you both added to the ship's manifest. Come and find me inside when you're ready to depart."))
    closemessage
    delay(20)
    applymovement(LOCALID_FLORIO_NATSUE, moves(walk_down * 3, walk_right, walk_down))
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_TARC3_FLORIO_NATSUE)
    removeobject(LOCALID_FLORIO_NATSUE)
    delay(30)
    applymovement(LOCALID_FLORIO_RAN_1, moves(face_up))
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("One problem, solved.\pDo not keep her waiting, {PLAYER} Edgeworth. I will see to our belongings."))
    setspeaker(NULL)
    closemessage
    applymovement(LOCALID_FLORIO_RAN_1, moves(walk_down * 3))
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_TARC3_FLORIO_RAN)
    removeobject(LOCALID_FLORIO_RAN_1)
    delay(30)
    setvar(VAR_TARC3_FLORIO_INTRO, 3)
    releaseall
    end
}

script tarc3_FlorioIsland_EventScript_ShipDeparts {
    lockall
    hideplayer
    delay(60)
    playse(SE_SHIP)
    delay(60)
    applymovement(LOCALID_FLORIO_SSHANA, tarc3_FlorioIsland_Movement_ShipDeparts)
    waitmovement(0)
    removeobject(LOCALID_FLORIO_SSHANA)
    delay(30)
    setflag(FLAG_HIDE_TARC3_LOCKUP_CAST)
    setvar(VAR_TARC3_FLORIO_INTRO, 5)
    warp(MAP_TARC3_HOLD, 13, 16)
    waitstate
    end
}

movement tarc3_FlorioIsland_Movement_ShipDeparts {
    walk_slow_left * 3
    walk_left * 3
    walk_fast_left * 3
    walk_faster_left * 12
}

script tarc3_FlorioIsland_EventScript_Dockhand {
    lock
    faceplayer
    msgbox(format("Her? That one at the end of the pier?\pShe's the SS Hana. A Hatamoto Corp private charter."))
    msgbox(format("Their whole family is aboard. They came all the way here for the daughter's wedding."))
    release
    end
}
