mapscripts tarc3_Foredeck_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: tarc3_Foredeck_OnTransition
    MAP_SCRIPT_ON_LOAD: tarc3_Foredeck_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TARC3_ACT1, TARC3_ACT1_BOARDED: tarc3_Foredeck_EventScript_Departure
        VAR_TARC3_ACT2, TARC3_ACT2_BODY_ON_DECK: tarc3_Foredeck_EventScript_TatsuoBody
    ]
}

script tarc3_Foredeck_OnTransition {
    if (var(VAR_TARC3_ACT2) == TARC3_ACT2_BODY_ON_DECK) {
        savebgm(MUS_NONE)
    }
    end
}

script tarc3_Foredeck_OnLoad {
    setflag(FLAG_HIDE_TARC3_COMFEY)
    setflag(FLAG_HIDE_TARC3_DECK2_CAST)
    setflag(FLAG_HIDE_TARC3_DECK2_FOLLOWERS)
    setflag(FLAG_HIDE_TARC3_DECK2_CRAMORANT)
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_BODY_ON_DECK) {
        call(tarc3_Foredeck_EventScript_BloodiedDeck)
    }
    if (var(VAR_TARC3_ACT2) < TARC3_ACT2_BODY_ON_DECK) {
        setflag(FLAG_HIDE_TARC3_DECK2_BODY)
        setflag(FLAG_HIDE_TARC3_DECK2_RAN)
    } elif (var(VAR_TARC3_ACT2) == TARC3_ACT2_DECK_INVESTIGATE) {
        clearflag(FLAG_HIDE_TARC3_DECK2_BODY)
        clearflag(FLAG_HIDE_TARC3_DECK2_RAN)
        clearflag(FLAG_HIDE_TARC3_DECK2_CAST)
        clearflag(FLAG_HIDE_TARC3_DECK2_FOLLOWERS)
    } else {
        clearflag(FLAG_HIDE_TARC3_DECK2_BODY)
        setflag(FLAG_HIDE_TARC3_DECK2_RAN)
    }
    end
}

script tarc3_Foredeck_EventScript_BloodiedDeck {
    setmetatile(17, 15, 0x0F4, TRUE)
    if (!flag(FLAG_TARC3_DECK2_FOUND_CLOTH)) {
        setmetatile(22, 17, 0x0F3, TRUE)
        setmetatile(22, 18, 0x0FB, TRUE)
    }
    return
}

script tarc3_Foredeck_EventScript_Departure {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_down * 2, face_left))
    waitmovement(0)
    delay(40)
    applymovement(LOCALID_FOREDECK_NATSUE, moves(face_right))
    waitmovement(0)
    setspeaker("Natsue")
    msgbox(format("I never introduced myself properly, did I.\pI'm Natsue Hatamoto."))
    closemessage
    delay(20)
    applymovement(LOCALID_FOREDECK_NATSUE, moves(face_down))
    waitmovement(0)
    delay(30)
    setspeaker("Natsue")
    msgbox(format("And this is my husband, Takeshi."))
    setspeaker("Takeshi")
    msgbox(format("Thank you for keeping her company out here.\pShe's been on her feet since sunrise."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_FOREDECK_NATSUE, moves(face_right))
    waitmovement(0)
    setspeaker("Natsue")
    msgbox(format("I'm glad you both made it aboard.\pI hope the cabin is comfortable enough."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_FOREDECK_NATSUE, moves(face_up))
    waitmovement(0)
    delay(30)
    setspeaker("Natsue")
    msgbox(format("We celebrated our wedding on Florio this morning. It was a small ceremony."))
    msgbox(format("My parents should have been sat at the front of it.\pThey passed two years ago. Both of them, in the same accident."))
    msgbox(format("I kept looking for them as I walked down the aisle.\pI wanted them to see me dressed like this..."))
    setspeaker("Takeshi")
    msgbox(format("Natsue."))
    applymovement(LOCALID_FOREDECK_NATSUE, moves(face_down))
    setspeaker("Natsue")
    msgbox(format("...I know. I'm sorry.\pIt's meant to be a happy day, and here I am."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_FOREDECK_NATSUE, moves(face_right))
    waitmovement(0)
    delay(20)
    setspeaker("Natsue")
    msgbox(format("Oh. I almost forgot."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_FOREDECK_NATSUE, moves(face_left))
    waitmovement(0)
    playmoncry(SPECIES_COMFEY, CRY_MODE_ENCOUNTER)
    waitmoncry
    delay(30)
    applymovement(LOCALID_FOREDECK_NATSUE, moves(face_down, walk_in_place_slow_down))
    waitmovement(0)
    delay(20)
    msgbox(format("Natsue lifts a flower from her Comfey and pins it to Takeshi's lapel."))
    setspeaker("Natsue")
    msgbox(format("It's been my dream since I was small to give my partner one of these."))
    msgbox(format("My Comfey grows the most beautiful flowers."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_FOREDECK_NATSUE, moves(face_right))
    waitmovement(0)
    delay(30)
    playse(SE_DOOR)
    clearflag(FLAG_HIDE_TARC3_FOREDECK_GOZO)
    addobject(LOCALID_FOREDECK_GOZO)
    delay(20)
    applymovement(LOCALID_FOREDECK_GOZO, moves(walk_left * 3, face_down))
    waitmovement(0)
    delay(20)
    playse(SE_PIN)
    applymovement(LOCALID_FOREDECK_GOZO, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    applymovement(LOCALID_FOREDECK_NATSUE, moves(face_up))
    applymovement(LOCALID_FOREDECK_TAKESHI, moves(face_up))
    waitmovement(0)
    delay(20)
    setspeaker("Gozo")
    msgbox(format("Strangers? On my ship?"))
    msgbox(format("Who authorised this?"))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_FOREDECK_KITARO, moves(walk_right * 2, walk_down, face_right))
    waitmovement(0)
    applymovement(LOCALID_FOREDECK_GOZO, moves(face_left))
    waitmovement(0)
    delay(20)
    setspeaker("Kitaro")
    msgbox(format("I did, Father."))
    msgbox(format("They missed the last ferry off Florio. There was room, and it seemed a small..."))
    setspeaker("Gozo")
    msgbox(format("Silence. We'll discuss it later."))
    msgbox(format("I came out here with a request.\pPull the art school accounts when we dock."))
    msgbox(format("Eleven years of tuition and not one commission to show for it."))
    msgbox(format("A boy can only trade on 'promising student' for so long."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_FOREDECK_ICHIRO, moves(face_down))
    applymovement(LOCALID_FOREDECK_TATSUO, moves(face_up))
    waitmovement(0)
    delay(40)
    applymovement(LOCALID_FOREDECK_GOZO, moves(face_left))
    waitmovement(0)
    setspeaker("Gozo")
    msgbox(format("Takeshi. Come, join me. We have much to discuss."))
    setspeaker(NULL)
    closemessage
    delay(40)
    applymovement(LOCALID_FOREDECK_GOZO, moves(walk_right * 3))
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_TARC3_FOREDECK_GOZO)
    removeobject(LOCALID_FOREDECK_GOZO)
    delay(20)
    applymovement(LOCALID_FOREDECK_RAN, moves(walk_down, face_up))
    waitmovement(0)
    applymovement(LOCALID_FOREDECK_TAKESHI, moves(walk_right * 2, walk_up * 2, walk_right * 2))
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_TARC3_FOREDECK_TAKESHI)
    removeobject(LOCALID_FOREDECK_TAKESHI)
    delay(30)
    applymovement(LOCALID_FOREDECK_RAN, moves(walk_up, face_up))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("The grandfather of the bride.\pI have seen men climbing Mount Coronet display more warmth than that."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_FOREDECK_NATSUE, moves(walk_down, face_right))
    applymovement(LOCALID_FOREDECK_RAN, moves(face_left))
    waitmovement(0)
    delay(20)
    setspeaker("Natsue")
    msgbox(format("Let's not dwell on it.\pCome with me, I'll introduce you to the rest of my family."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("You have your notebook, {PLAYER} Edgeworth. Use it."))
    setspeaker(NULL)
    closemessage
    delay(20)
    giveevidence(EVD_TUITION_FUNDS)
    giveevidence(EVD_TAKESHIS_MEETING)
    closemessage
    delay(20)
    applymovement(LOCALID_FOREDECK_RAN, moves(face_up))
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("A detail you fail to record is a detail you have thrown away."))
    msgbox(format("We will meet at the cabin later.\pLook around for as long as you care to."))
    setspeaker(NULL)
    closemessage
    delay(20)
    fadescreenswapbuffers(FADE_TO_BLACK)
    setflag(FLAG_TARC3_EVIDENCE_MENU)
    setflag(FLAG_HIDE_TARC3_FOREDECK_RAN)
    setflag(FLAG_HIDE_TARC3_FOREDECK_NATSUE)
    setflag(FLAG_HIDE_TARC3_FOREDECK_COMFEY)
    removeobject(LOCALID_FOREDECK_RAN)
    removeobject(LOCALID_FOREDECK_NATSUE)
    removeobject(LOCALID_FOREDECK_COMFEY)
    setobjectxy(LOCALID_FOREDECK_KITARO, 11, 12)
    applymovement(LOCALID_FOREDECK_KITARO, moves(face_right))
    waitmovement(0)
    setvar(VAR_TARC3_ACT1, TARC3_ACT1_DEPARTED)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(20)
    msgbox(format("{FONT_NARROW}Hmm.\pThis family is at each other's throats.", "1_latin_rse_narrow"))
    closemessage
    releaseall
    end
}

script tarc3_Foredeck_EventScript_Ichiro {
    lock
    faceplayer
    setspeaker("Ichiro")
    msgbox(format("Hm? Oh. You're the one they picked up at Florio."))
    msgbox(format("The wedding?\pIt was... fine. The location was nice."))
    msgbox(format("I got some good sketches, at least."))
    msgbox(format("...Natsue seems happy."))
    setspeaker(NULL)
    closemessage
    if (var(VAR_TARC3_ACT1) >= TARC3_ACT1_DEPARTED && !defeated(TRAINER_TARC3_ICHIRO)) {
        goto(tarc3_Foredeck_EventScript_IchiroBattle)
    }
    release
    end
}

script tarc3_Foredeck_EventScript_IchiroBattle {
    delay(20)
    setspeaker("Ichiro")
    msgbox(format("...You're carrying Pokémon."))
    msgbox(format("I'm looking for a new source of inspiration.\pMay we battle?"))
    setspeaker(NULL)
    closemessage
    setflag(FLAG_TARC3_NO_WHITEOUT)
    trainerbattle_no_intro(TRAINER_TARC3_ICHIRO, tarc3_Foredeck_Text_IchiroDefeat)
    clearflag(FLAG_TARC3_NO_WHITEOUT)
    specialvar(VAR_RESULT, GetBattleOutcome)
    goto_if_ne(VAR_RESULT, B_OUTCOME_WON, tarc3_Foredeck_EventScript_IchiroBattleLost)
    delay(20)
    setspeaker("Ichiro")
    msgbox(format("Thank you.\pI... I tend to fixate on my drawing subjects. Battles help break that up."))
    msgbox(format("I'll heal your team."))
    setspeaker(NULL)
    closemessage
    msgbox(format("{FONT_NARROW}His strategy was perplexing.\pPerhaps it is something I should study further.", "1_latin_rse_narrow"))
    giveevidence(EVD_SMEARGLE_REPERTOIRE)
    closemessage
    goto(tarc3_Foredeck_EventScript_IchiroBattleEnd)
}

script tarc3_Foredeck_EventScript_IchiroBattleLost {
    settrainerflag(TRAINER_TARC3_ICHIRO)
    delay(20)
    setspeaker("Ichiro")
    msgbox(format("Looks can be deceiving, I suppose.\pHere, let me put your team right before you go."))
    setspeaker(NULL)
    closemessage
    goto(tarc3_Foredeck_EventScript_IchiroBattleEnd)
}

script tarc3_Foredeck_EventScript_IchiroBattleEnd {
    special(HealPlayerParty)
    delay(20)
    release
    end
}

text tarc3_Foredeck_Text_IchiroDefeat {
    format("Still can't focus.")
}


script tarc3_Foredeck_EventScript_Sketchbook {
    lockall
    if (var(VAR_TARC3_ACT1) >= TARC3_ACT1_DINNER) {
        msgbox(format("The rail is bare. Ichiro took the sketchbook in with him before dinner."))
        closemessage
        releaseall
        end
    }
    msgbox(format("An open sketchbook, weighted flat against the rail."))
    msgbox(format("It's a half-finished sketch of a woman standing next to a man with dark hair."))
    closemessage
    delay(20)
    playse(SE_M_GUST)
    delay(30)
    msgbox(format("The wind takes the pages before {PLAYER} can make out who it is."))
    closemessage
    // EVD_CHARCOAL_SKETCHES cut
    closemessage
    releaseall
    end
}

script tarc3_Foredeck_EventScript_Tatsuo {
    lock
    faceplayer
    setspeaker("Tatsuo")
    msgbox(format("A kid... They let a kid aboard?!\pWhy not, I guess.\pEveryone else here is also freeloading."))
    msgbox(format("You know what this family is worth? Neither do I.\pThe old man won't tell us."))
    msgbox(format("I just spend my time out here on the deck.\pAkie locks me out of the cabin when she's angry, and she's always angry."))
    setspeaker(NULL)
    closemessage
    if (var(VAR_TARC3_ACT1) >= TARC3_ACT1_DEPARTED && !defeated(TRAINER_TARC3_TATSUO)) {
        goto(tarc3_Foredeck_EventScript_TatsuoBattle)
    }
    release
    end
}

script tarc3_Foredeck_EventScript_TatsuoBattle {
    delay(20)
    setspeaker("Tatsuo")
    msgbox(format("Hold on. You're a trainer?"))
    msgbox(format("Then make yourself useful. Let's kill some time."))
    setspeaker(NULL)
    closemessage
    setflag(FLAG_TARC3_NO_WHITEOUT)
    trainerbattle_no_intro(TRAINER_TARC3_TATSUO, tarc3_Foredeck_Text_TatsuoDefeat)
    clearflag(FLAG_TARC3_NO_WHITEOUT)
    specialvar(VAR_RESULT, GetBattleOutcome)
    goto_if_ne(VAR_RESULT, B_OUTCOME_WON, tarc3_Foredeck_EventScript_TatsuoBattleLost)
    delay(20)
    setspeaker("Tatsuo")
    msgbox(format("Fine. Fine!\pYou've had more practice than you let on."))
    msgbox(format("Here - wanna hear a secret?"))
    msgbox(format("I put my weight on some deck fittings earlier and snapped the lot of them clean off."))
    applymovement(LOCALID_FOREDECK_TATSUO, moves(face_right))
    waitmovement(0)
    msgbox(format("I stuffed the pieces into that equipment sack and said nothing.\pNobody's given it a second glance."))
    faceplayer
    msgbox(format("Don't tell the old man. He'd find a way to bill me for it."))
    setspeaker(NULL)
    closemessage
    msgbox(format("{FONT_NARROW}Broken fittings - lengths of pipe, from the look of them - hidden in the equipment sack rather than reported.\pHis approach to consequences does not surprise me.", "1_latin_rse_narrow"))
    giveevidence(EVD_HIDDEN_PIPE)
    closemessage
    goto(tarc3_Foredeck_EventScript_TatsuoBattleEnd)
}

script tarc3_Foredeck_EventScript_TatsuoBattleLost {
    settrainerflag(TRAINER_TARC3_TATSUO)
    delay(20)
    setspeaker("Tatsuo")
    msgbox(format("Ha! And they call me the freeloader."))
    setspeaker(NULL)
    closemessage
    goto(tarc3_Foredeck_EventScript_TatsuoBattleEnd)
}

script tarc3_Foredeck_EventScript_TatsuoBattleEnd {
    special(HealPlayerParty)
    delay(20)
    release
    end
}

text tarc3_Foredeck_Text_TatsuoDefeat {
    format("Of course. Of course!")
}


script tarc3_Foredeck_EventScript_Kitaro {
    lock
    faceplayer
    setspeaker("Kitaro")
    msgbox(format("You heard all of that, I imagine.\pHe doesn't lower his voice. He never has."))
    msgbox(format("Twenty-two years I've run that division for him.\pHe still introduces me as the man Mariko married."))
    msgbox(format("...Forget I said any of that. You're a guest here."))
    setspeaker(NULL)
    release
    end
}




// CS8

script tarc3_Foredeck_EventScript_TatsuoBody {
    lockall
    fadenewbgm(MUS_NONE)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_down * 2, face_left))
    waitmovement(0)
    delay(20)
    playse(SE_EXIT)
    clearflag(FLAG_HIDE_TARC3_DECK2_RAN)
    clearflag(FLAG_HIDE_TARC3_DECK2_FOLLOWERS)
    addobject(LOCALID_FOREDECK_RAN_2)
    addobject(LOCALID_FOREDECK_NATSUE_2)
    delay(20)
    applymovement(LOCALID_FOREDECK_RAN_2, moves(walk_left, face_left))
    applymovement(LOCALID_FOREDECK_NATSUE_2, moves(walk_left, face_left))
    waitmovement(0)
    delay(20)
    delay(60)
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    playse(SE_PIN)
    applymovement(LOCALID_FOREDECK_NATSUE_2, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    setspeaker("Natsue")
    msgbox(format("Tatsuo?"))
    delay(40)
    msgbox(format("...\pAAAAAH!"))
    setspeaker(NULL)
    closemessage
    delay(30)
    fadescreenswapbuffers(FADE_TO_BLACK)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_left * 2))
    waitmovement(0)
    clearflag(FLAG_HIDE_TARC3_DECK2_CAST)
    addobject(LOCALID_FOREDECK_SUZUKI_2)
    addobject(LOCALID_FOREDECK_MARIKO_2)
    addobject(LOCALID_FOREDECK_AKIE_2)
    addobject(LOCALID_FOREDECK_KITARO_2)
    addobject(LOCALID_FOREDECK_JOJI_2)
    addobject(LOCALID_FOREDECK_ICHIRO_2)
    setobjectxy(OBJ_EVENT_ID_PLAYER, 12, 15)
    setobjectxy(LOCALID_FOREDECK_RAN_2, 12, 14)
    setobjectxy(LOCALID_FOREDECK_NATSUE_2, 13, 14)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    applymovement(LOCALID_FOREDECK_RAN_2, moves(face_left))
    applymovement(LOCALID_FOREDECK_NATSUE_2, moves(face_left))
    waitmovement(0)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(40)
    applymovement(LOCALID_FOREDECK_SUZUKI_2, moves(walk_in_place_fast_down))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("A blow to the back of the head.\pFrom something blunt, I assume."))
    setspeaker(NULL)
    closemessage
    delay(30)
    setspeaker("Akie")
    msgbox(format("I told him to get away from me.\pThat was the last thing I said to him."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_FOREDECK_RAN_2, moves(walk_in_place_fast_left))
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("Time is of the essence."))
    msgbox(format("{PLAYER} Edgeworth. Inspect the scene."))
    setspeaker(NULL)
    closemessage
    delay(20)
    special(RemoveCameraObject)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_DECK_INVESTIGATE)
    releaseall
    end
}

// CS8 continues, once the reconstruction has been delivered

script tarc3_Foredeck_EventScript_TatsuoBodyToHold {
    applymovement(LOCALID_FOREDECK_MARIKO_2, moves(walk_in_place_fast_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("Takeshi. It was Takeshi."))
    setspeaker("Ichiro")
    msgbox(format("He's in the hold. We put him in the hold ourselves."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_FOREDECK_MARIKO_2, moves(face_right))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("Is he?"))
    delay(40)
    msgbox(format("Have any of you been down there since? Even once?"))
    setspeaker(NULL)
    closemessage
    delay(40)
    applymovement(LOCALID_FOREDECK_MARIKO_2, moves(face_left))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("You stay here. I'll check the hold myself."))
    applymovement(LOCALID_FOREDECK_SUZUKI_2, moves(face_right))
    setspeaker("Suzuki")
    msgbox(format("...No. There is a killer aboard. For everyone's safety, we will check together."))
    setspeaker(NULL)
    closemessage
    delay(30)
    setflag(FLAG_HIDE_TARC3_DECK2_CAST)
    setflag(FLAG_HIDE_TARC3_DECK2_FOLLOWERS)
    setflag(FLAG_HIDE_TARC3_DECK2_RAN)
    clearflag(FLAG_HIDE_TARC3_HOLD2_CAST)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_HOLD_SEARCH)
    warp(MAP_TARC3_HOLD, 17, 18)
    waitstate
    end
}

// investigation - outside deck

script tarc3_Foredeck_EventScript_DeckInvestigateRan {
    lock
    faceplayer
    setspeaker("{RIVAL}")
    msgbox(format("Are you ready to tell them what happened on this deck?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Then finish your inspection.\pThe body, the deck, the rail, the equipment. All of it."))
        setspeaker(NULL)
        release
        end
    }
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("Very well. This deck has told you its story.\pWere you paying attention, {PLAYER} Edgeworth?"))
    setspeaker(NULL)
    closemessage
    delay(20)
    fadescreenswapbuffers(FADE_TO_BLACK)
    hidefollower
    setobjectxy(OBJ_EVENT_ID_PLAYER, 12, 15)
    setobjectxy(LOCALID_FOREDECK_RAN_2, 12, 14)
    setobjectxy(LOCALID_FOREDECK_NATSUE_2, 13, 14)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    applymovement(LOCALID_FOREDECK_RAN_2, moves(face_down))
    applymovement(LOCALID_FOREDECK_NATSUE_2, moves(face_left))
    waitmovement(0)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("All of you. {PLAYER} Edgeworth will attempt to explain what happened here."))
    setspeaker(NULL)
    closemessage
    delay(20)
    call(tarc3_TatsuoRecon_EventScript_Begin)
    goto(tarc3_Foredeck_EventScript_TatsuoBodyToHold)
}

script tarc3_Foredeck_EventScript_Phase2ANoExit {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left))
    waitmovement(0)
    msgbox(format("{FONT_NARROW}They are all still on this deck.\pI am not walking away from it yet.", "1_latin_rse_narrow"))
    releaseall
    end
}

// investigation

script tarc3_Foredeck_EventScript_EvdBody {
    lockall
    goto_if_set(FLAG_TARC3_DECK2_FOUND_BODY, tarc3_Foredeck_EventScript_EvdBodySeen)
    msgbox(format("Tatsuo, down against the foot of the rail. The back of his skull is caved in. One blow, from something blunt and heavy."))
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}Nothing in his hands and no defensive wounds. He was facing the water, and didn't see it coming at all.", "1_latin_rse_narrow"))
    closemessage
    // EVD_BLUNT_WOUND cut
    closemessage
    setflag(FLAG_TARC3_DECK2_FOUND_BODY)
    releaseall
    end
}

script tarc3_Foredeck_EventScript_EvdBodySeen {
    msgbox(format("Tatsuo Kaneko. Struck once from behind, at the rail, still facing the sea."))
    releaseall
    end
}

script tarc3_Foredeck_EventScript_EvdPipe {
    lockall
    if (var(VAR_TARC3_ACT2) < TARC3_ACT2_BODY_ON_DECK) {
        goto(tarc3_Foredeck_EventScript_EvdPipeQuiet)
    }
    goto_if_set(FLAG_TARC3_DECK2_FOUND_WEAPON, tarc3_Foredeck_EventScript_EvdPipeSeen)
    msgbox(format("An equipment sack. Two lengths of pipe jut out of the top."))
    closemessage
    delay(20)
    msgbox(format("One is clean. The other is dark and tacky along its length."))
    closemessage
    delay(20)
    checkevidence(EVD_HIDDEN_PIPE)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(format("{FONT_NARROW}These are the fittings Tatsuo broke this afternoon. He hid them in here to pass for ship's equipment.", "1_latin_rse_narrow"))
    }
    msgbox(format("{FONT_NARROW}Something blunt and heavy, with blood on it, four paces from where he fell.\pAnd it is still sitting in the sack.", "1_latin_rse_narrow"))
    closemessage
    // EVD_DISPLACED_PIPE cut
    closemessage
    setflag(FLAG_TARC3_DECK2_FOUND_WEAPON)
    call(tarc3_Foredeck_EventScript_OfferStoutlandPipe)
    releaseall
    end
}

script tarc3_Foredeck_EventScript_EvdPipeQuiet {
    msgbox(format("An equipment sack. Two lengths of pipe jut out of the top."))
    checkevidence(EVD_HIDDEN_PIPE)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(format("{FONT_NARROW}Tatsuo's handiwork. The broken fittings he stuffed in here look no different from the rest.", "1_latin_rse_narrow"))
        closemessage
    }
    releaseall
    end
}

script tarc3_Foredeck_EventScript_EvdPipeSeen {
    msgbox(format("The equipment sack. Two lengths of pipe, one of them bloodied."))
    call(tarc3_Foredeck_EventScript_OfferStoutlandPipe)
    releaseall
    end
}

// Stoutland can tell what else is on the pipe

script tarc3_Foredeck_EventScript_OfferStoutlandPipe {
    goto_if_set(FLAG_TARC3_DECK2_PIPE_SCENT, tarc3_EventScript_OfferEnd)
    setvar(VAR_0x8004, SPECIES_STOUTLAND)
    specialvar(VAR_RESULT, DoesPlayerPartyContainSpecies)
    goto_if_eq(VAR_RESULT, FALSE, tarc3_EventScript_OfferEnd)
    msgbox(format("{FONT_NARROW}Blood is not the only thing that clings to a length of pipe.", "1_latin_rse_narrow"))
    msgbox(format("Have Stoutland examine the pipe?"), MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, NO, tarc3_EventScript_OfferEnd)
    goto(tarc3_Foredeck_EventScript_FollowerStoutlandSack)
}

script tarc3_Foredeck_EventScript_FollowerStoutlandSack {
    goto_if_unset(FLAG_TARC3_DECK2_FOUND_WEAPON, tarc3_EventScript_FollowerHookEnd)
    goto_if_set(FLAG_TARC3_DECK2_PIPE_SCENT, tarc3_EventScript_FollowerHookEnd)
    getlivemonspecies(VAR_0x8008)
    if (var(VAR_0x8008) == SPECIES_STOUTLAND) {
        applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_up, walk_in_place_fast_right, walk_in_place_fast_down))
        waitmovement(0)
    }
    delay(20)
    msgbox(format("Stoutland works its nose along the pipe, and then along it again."))
    closemessage
    delay(20)
    playmoncry(SPECIES_STOUTLAND, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("{FONT_NARROW}It is not the blood it is going back for. There is something else on this pipe.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}Fine black dust, worked into the grip end of it.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_DECK2_PIPE_SCENT)
    goto(tarc3_EventScript_FollowerHandled)
}

// investigation - the family, still standing over him

script tarc3_Foredeck_EventScript_Deck2Akie {
    lock
    faceplayer
    setspeaker("Akie")
    msgbox(format("He was out here because I yelled at him.\pI told him to get away from me.\pSo he went."))
    setspeaker(NULL)
    closemessage
    release
    end
}

script tarc3_Foredeck_EventScript_Deck2Suzuki {
    lock
    faceplayer
    setspeaker("Suzuki")
    msgbox(format("One blow, and the back of the head. He was not expecting it."))
    msgbox(format("Thirty-one years I have supported this family.\pI have never seen anything like tonight."))
    setspeaker(NULL)
    closemessage
    release
    end
}

script tarc3_Foredeck_EventScript_Deck2Mariko {
    lock
    faceplayer
    setspeaker("Mariko")
    msgbox(format("You needn't stand there frowning. We already know who did this."))
    setspeaker(NULL)
    release
    end
}

script tarc3_Foredeck_EventScript_Deck2Kitaro {
    lock
    faceplayer
    setspeaker("Kitaro")
    msgbox(format("I never left the dining room. Suzuki and Joji will tell you the same."))
    msgbox(format("The first any of us knew of it was the shouting."))
    setspeaker(NULL)
    closemessage
    goto_if_set(FLAG_TARC3_KITARO_SMEARGLE, tarc3_Foredeck_EventScript_Deck2KitaroBattle)
    release
    end
}

script tarc3_Foredeck_EventScript_Deck2KitaroBattle {
    setspeaker("Kitaro")
    msgbox(format("Ichiro sat with us a while. Asked me for a battle, of all things.\pI think he went back to his cabin afterwards."))
    setspeaker(NULL)
    closemessage
    release
    end
}

script tarc3_Foredeck_EventScript_Deck2Joji {
    lock
    faceplayer
    setspeaker("Joji")
    msgbox(format("The galley, and then the dining room. Suzuki was stood right beside me the whole time."))
    msgbox(format("I'd only just finished cleaning down.\pAnd then this."))
    setspeaker(NULL)
    closemessage
    release
    end
}

script tarc3_Foredeck_EventScript_Deck2Natsue {
    lock
    faceplayer
    setspeaker("Natsue")
    msgbox(format("I'm sorry. I can't - I keep looking at him."))
    setspeaker(NULL)
    release
    end
}

script tarc3_Foredeck_EventScript_Deck2Ichiro {
    lock
    faceplayer
    setspeaker("Ichiro")
    msgbox(format("Takeshi's in the hold. So it can't have been him, can it."))
    delay(20)
    msgbox(format("...Or did he escape?"))
    setspeaker(NULL)
    release
    end
}

script tarc3_Foredeck_EventScript_EvdCloth {
    setflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
    lockall
    goto_if_set(FLAG_TARC3_DECK2_FOUND_CLOTH, tarc3_Foredeck_EventScript_EvdClothSeen)
    if (var(VAR_TARC3_ACT2) < TARC3_ACT2_BODY_ON_DECK) {
        msgbox(format("The railing continues along the ship."))
        releaseall
        end
    }
    msgbox(format("A cloth is snagged on the rail.\pIt is dark along one edge."))
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}There's something out there, but I can't reach it.", "1_latin_rse_narrow"))
    closemessage
    getlivemonspecies(VAR_0x8005)
    goto_if_eq(VAR_0x8005, SPECIES_CRAMORANT, tarc3_Foredeck_EventScript_EvdClothFollower)
    setvar(VAR_0x8004, SPECIES_CRAMORANT)
    specialvar(VAR_RESULT, DoesPlayerPartyContainSpecies)
    goto_if_eq(VAR_RESULT, TRUE, tarc3_Foredeck_EventScript_EvdClothCramorant)
    releaseall
    end
}

script tarc3_Foredeck_EventScript_EvdClothFollower {
    delay(20)
    playmoncry(SPECIES_CRAMORANT, CRY_MODE_ENCOUNTER)
    waitmoncry
    delay(20)
    applymovement(OBJ_EVENT_ID_FOLLOWER, moves(jump_2_right, walk_fast_right * 6, face_down, walk_in_place_fast_down))
    waitmovement(0)
    delay(20)
    setmetatile(22, 17, 0x094, TRUE)
    setmetatile(22, 18, 0x09C, TRUE)
    special(DrawWholeMapView)
    delay(20)
    applymovement(OBJ_EVENT_ID_FOLLOWER, moves(face_left, walk_fast_left * 6, jump_2_left, face_right))
    waitmovement(0)
    delay(20)
    goto(tarc3_Foredeck_EventScript_EvdClothTaken)
}

script tarc3_Foredeck_EventScript_EvdClothCramorant {
    hidefollower
    delay(20)
    playmoncry(SPECIES_CRAMORANT, CRY_MODE_ENCOUNTER)
    waitmoncry
    clearflag(FLAG_HIDE_TARC3_DECK2_CRAMORANT)
    addobject(LOCALID_FOREDECK_CRAMORANT_2)
    delay(20)
    applymovement(LOCALID_FOREDECK_CRAMORANT_2, moves(walk_fast_right * 6, face_down, walk_in_place_fast_down))
    waitmovement(0)
    delay(20)
    setmetatile(22, 17, 0x094, TRUE)
    setmetatile(22, 18, 0x09C, TRUE)
    special(DrawWholeMapView)
    delay(20)
    applymovement(LOCALID_FOREDECK_CRAMORANT_2, moves(face_left, walk_fast_left * 6, face_right))
    waitmovement(0)
    delay(20)
    setflag(FLAG_HIDE_TARC3_DECK2_CRAMORANT)
    removeobject(LOCALID_FOREDECK_CRAMORANT_2)
    delay(20)
    goto(tarc3_Foredeck_EventScript_EvdClothTaken)
}

script tarc3_Foredeck_EventScript_EvdClothTaken {
    msgbox(format("Cramorant drops a scrap of cloth at {PLAYER}'s feet."))
    giveevidence(EVD_BLOODY_CLOTH)
    closemessage
    setflag(FLAG_TARC3_DECK2_FOUND_CLOTH)
    releaseall
    end
}

script tarc3_Foredeck_EventScript_EvdClothSeen {
    msgbox(format("The rail is bare. The bloodied cloth is in {PLAYER}'s bag."))
    releaseall
    end
}
