mapscripts tarc3_GozoRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD: tarc3_GozoRoom_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TARC3_ACT1, TARC3_ACT1_THE_BODY: tarc3_GozoRoom_EventScript_TheBody
    ]
}

// CS3

script tarc3_GozoRoom_EventScript_TheBody {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovement(0)
    delay(30)
    clearflag(FLAG_HIDE_TARC3_GOZO_SUZUKI)
    clearflag(FLAG_HIDE_TARC3_HALL_NATSUE)
    clearflag(FLAG_HIDE_TARC3_HALL_TAKESHI)
    clearflag(FLAG_HIDE_TARC3_HALL_JOJI)
    clearflag(FLAG_HIDE_TARC3_HALL_MARIKO)
    clearflag(FLAG_HIDE_TARC3_HALL_KITARO)
    clearflag(FLAG_HIDE_TARC3_HALL_ICHIRO)
    clearflag(FLAG_HIDE_TARC3_HALL_AKIE)
    clearflag(FLAG_HIDE_TARC3_HALL_TATSUO)
    addobject(LOCALID_GOZOROOM_SUZUKI)
    addobject(LOCALID_GOZOROOM_NATSUE)
    addobject(LOCALID_GOZOROOM_TAKESHI)
    addobject(LOCALID_GOZOROOM_JOJI)
    addobject(LOCALID_GOZOROOM_MARIKO)
    addobject(LOCALID_GOZOROOM_KITARO)
    addobject(LOCALID_GOZOROOM_ICHIRO)
    addobject(LOCALID_GOZOROOM_AKIE)
    addobject(LOCALID_GOZOROOM_TATSUO)
    delay(40)
    applymovement(LOCALID_GOZOROOM_SUZUKI, moves(walk_in_place_slow_up))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("It is locked. And he is not answering."))
    msgbox(format("It can only be unlocked from inside the room, or with a door key.\pI have the only spare key for the room."))
    setspeaker("Mariko")
    msgbox(format("Then use it!\pOpen it already!"))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_GOZOROOM_SUZUKI, moves(walk_in_place_slow_up))
    waitmovement(0)
    playse(SE_PIN)
    delay(60)
    msgbox(format("The lock turns.")) // probably a sound effect to use here
    closemessage
    delay(20)
    playse(SE_EXIT)
    call(tarc3_GozoRoom_EventScript_RevealRoom)
    special(DrawWholeMapView)
    clearflag(FLAG_HIDE_TARC3_GOZO_BODY)
    addobject(LOCALID_GOZOROOM_GOZO_BODY)
    delay(30)
    applymovement(LOCALID_GOZOROOM_SUZUKI, moves(walk_up))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_GOZOROOM_SUZUKI, moves(walk_left, walk_up))
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_GOZOROOM_SUZUKI, moves(face_right))
    waitmovement(0)
    delay(20)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left, walk_up))
    waitmovement(0)
    delay(40)
    msgbox(format("Gozo Hatamoto's body is on the floor."))
    msgbox(format("Wounds across the chest. More than one, struck again and again."))
    closemessage
    delay(30)
    applymovement(LOCALID_GOZOROOM_SUZUKI, moves(face_down))
    setspeaker("Suzuki")
    msgbox(format("Gozo."))
    msgbox(format("...I walked past this door a little over half an hour ago."))
    msgbox(format("I came back to call him through for dinner, but I saw the blood.\pThat is when I shouted for you all."))
    setspeaker(NULL)
    closemessage
    delay(30)
    msgbox(format("{FONT_NARROW}Blood on the doorframe, but the door was shut and locked.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}That only happens one way. He was cut before the door closed, not after.", "1_latin_rse_narrow"))
    closemessage
    // EVD_BLOODY_DOORFRAME cut
    closemessage
    delay(30)
    msgbox(format("{FONT_NARROW}The blood has gone dark at the edges.\pIt happened about forty minutes ago.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}Which puts it at seven o'clock.\pSuzuki walked this corridor minutes later and saw nothing suspect.", "1_latin_rse_narrow"))
    closemessage
    delay(20)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    delay(30)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_down * 3))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_GOZOROOM_AKIE, moves(walk_in_place_slow_up))
    waitmovement(0)
    setspeaker("Akie")
    msgbox(format("He must have done it to himself."))
    setspeaker(NULL)
    closemessage
    delay(20)
    playse(SE_PIN)
    applymovement(LOCALID_GOZOROOM_SUZUKI, moves(emote_exclamation_mark))
    applymovement(LOCALID_GOZOROOM_NATSUE, moves(emote_exclamation_mark))
    applymovement(LOCALID_GOZOROOM_TAKESHI, moves(emote_exclamation_mark))
    applymovement(LOCALID_GOZOROOM_JOJI, moves(emote_exclamation_mark))
    applymovement(LOCALID_GOZOROOM_KITARO, moves(emote_exclamation_mark))
    applymovement(LOCALID_GOZOROOM_ICHIRO, moves(emote_exclamation_mark))
    applymovement(LOCALID_GOZOROOM_TATSUO, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(5)
    playse(SE_PIN)
    delay(3)
    playse(SE_PIN)
    delay(5)
    playse(SE_PIN)
    delay(20)
    setspeaker("Akie")
    msgbox(format("Don't look at me like that! He would do exactly this.\pLock the door and leave the rest of us staring at each other."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_GOZOROOM_MARIKO, moves(face_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("Akie."))
    setspeaker("Akie")
    msgbox(format("You know I'm right. He hated every one of us."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_CAMERA, moves(walk_up * 3))
    waitmovement(0)
    special(RemoveCameraObject)
    delay(20)
    applymovement(LOCALID_GOZOROOM_SUZUKI, moves(face_up))
    applymovement(LOCALID_GOZOROOM_NATSUE, moves(face_up))
    applymovement(LOCALID_GOZOROOM_TAKESHI, moves(face_up))
    applymovement(LOCALID_GOZOROOM_KITARO, moves(face_up))
    applymovement(LOCALID_GOZOROOM_ICHIRO, moves(face_up))
    applymovement(LOCALID_GOZOROOM_TATSUO, moves(face_up))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_GOZOROOM_JOJI, moves(walk_in_place_slow_up))
    waitmovement(0)
    setspeaker("Joji")
    msgbox(format("Then where is the knife?"))
    setspeaker(NULL)
    closemessage
    delay(40)
    setspeaker("Joji")
    msgbox(format("A man cannot do that to himself and then dispose of the blade.")) // perhaps a deduction?
    setspeaker(NULL)
    closemessage
    delay(30)
    msgbox(format("{FONT_NARROW}If he is right, the blade has to be somewhere in this room.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}And that flower was lying in the corridor before anybody knew he was dead.", "1_latin_rse_narrow"))
    closemessage
    delay(20)
    applymovement(LOCALID_GOZOROOM_MARIKO, moves(walk_in_place_slow_up))
    setspeaker("Mariko")
    msgbox(format("Why is the stranger investigating?")) // more than likely replacing conan with an adult character so can remove this
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_GOZOROOM_RAN, moves(walk_up,face_right))
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("Because not one of you has the first idea what you are looking at."))
    setspeaker(NULL)
    closemessage
    delay(30)
    call(tarc3_GozoRoom_EventScript_OfferMagnezoneSearch)
    setvar(VAR_TARC3_ACT1, TARC3_ACT1_INVESTIGATE_1)
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_ClearEvidence {
    setflag(FLAG_TARC3_GOZO_FOUND_GARLAND)
    setmetatile(8, 11, 0x071, FALSE)
    return
}

// CS4

script tarc3_GozoRoom_EventScript_Ran {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT1) > TARC3_ACT1_INVESTIGATE_1) {
        setspeaker("{RIVAL}")
        msgbox(format("Go on. They are listening."))
        setspeaker(NULL)
        release
        end
    }
    setspeaker("{RIVAL}")
    msgbox(format("They are all still standing out there, waiting for somebody to say something of substance."))
    msgbox(format("Have you seen everything you require in here?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Then take the time you need.\pI will keep them out of your way."))
        setspeaker(NULL)
        release
        end
    }
    setspeaker(NULL)
    closemessage
    setspeaker("{RIVAL}")
    msgbox(format("...You are certain. All of it?"))
    setspeaker(NULL)
    closemessage
    delay(20)
    fadescreen(FADE_TO_BLACK)
    call(tarc3_GozoRoom_EventScript_ClearEvidence)
    setobjectxy(OBJ_EVENT_ID_PLAYER, 10, 11)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    setobjectxy(LOCALID_GOZOROOM_SUZUKI, 9, 11)
    applymovement(LOCALID_GOZOROOM_SUZUKI, moves(face_down))
    waitmovement(0)
    special(DrawWholeMapView)
    hidefollower
    fadescreen(FADE_FROM_BLACK)
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("Silence, all of you.\pYou will listen to him."))
    setspeaker(NULL)
    closemessage
    delay(20)
    call(tarc3_Recon_EventScript_Begin)
    setvar(VAR_TARC3_ACT1, TARC3_ACT1_JAIL_TAKESHI)
    goto(tarc3_GozoRoom_EventScript_MarikosRevelation)
}

// CS5 - MARIKO'S REVELATION

script tarc3_GozoRoom_EventScript_MarikosRevelation {
    delay(30)
    applymovement(LOCALID_GOZOROOM_MARIKO, moves(walk_up, face_down))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
    waitmovement(0)
    delay(20)
    setspeaker("Mariko")
    msgbox(format("There is something you all need to hear."))
    msgbox(format("I told you I went down to Father's cabin before dinner and he didn't answer."))
    msgbox(format("I could hear him through the door though.\p...He was shouting."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_GOZOROOM_MARIKO, moves(face_left))
    waitmovement(0)
    delay(20)
    setspeaker("Mariko")
    msgbox(format("At Takeshi."))
    setspeaker(NULL)
    closemessage
    delay(20)
    playse(SE_PIN)
    applymovement(LOCALID_GOZOROOM_TAKESHI, moves(emote_exclamation_mark))
    waitmovement(0)
    applymovement(LOCALID_GOZOROOM_MARIKO, moves(face_down))
    delay(100)
    setspeaker("Mariko")
    msgbox(format("Ten years ago, Father orchestrated a hostile takeover of a company called Zaiki."))
    msgbox(format("Father was shouting that he knew exactly whose son had married into his family."))
    setspeaker(NULL)
    closemessage
    applymovement(LOCALID_GOZOROOM_SUZUKI, moves(walk_in_place_slow_down))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("Zaiki Research Institute."))
    msgbox(format("Isao Zaiki built a Pokémon transportation patent out of nothing at all.\pGozo acquired the company.\pZaiki couldn't handle the shame of having his company stolen from him.\pHe... he took his own life."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_GOZOROOM_NATSUE, moves(face_left))
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_GOZOROOM_TAKESHI, moves(walk_in_place_slow_right))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    setspeaker("Takeshi")
    msgbox(format("Zaiki. My name is Takeshi Zaiki."))
    msgbox(format("I joined Hatamoto Corporation, under my mother's name."))
    setspeaker("Natsue")
    msgbox(format("Takeshi..."))
    setspeaker("Takeshi")
    msgbox(format("..."))
    setspeaker(NULL)
    closemessage
    delay(40)
    applymovement(LOCALID_GOZOROOM_NATSUE, moves(face_down))
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_GOZOROOM_NATSUE, moves(walk_down, walk_right * 5))
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_TARC3_HALL_NATSUE)
    removeobject(LOCALID_GOZOROOM_NATSUE)
    delay(30)
    applymovement(LOCALID_GOZOROOM_TAKESHI, moves(face_right))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_GOZOROOM_MARIKO, moves(face_left))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("The flower outside that door was his.\pHe has just told you why he wanted my father dead."))
    msgbox(format("He is not walking around this ship for another night."))
    applymovement(LOCALID_GOZOROOM_TATSUO, moves(face_left))
    waitmovement(0)
    delay(20)
    setspeaker("Tatsuo")
    msgbox(format("Take him to the storage hold downstairs. It locks from the outside."))
    delay(60)
    setspeaker("Kitaro")
    msgbox(format("Mariko, we cannot simply..."))
    setspeaker("Mariko")
    msgbox(format("Take him down. He's a killer."))
    setspeaker(NULL)
    closemessage
    delay(40)
    fadescreen(FADE_TO_BLACK)
    setflag(FLAG_HIDE_TARC3_GOZO_SUZUKI)
    setflag(FLAG_HIDE_TARC3_HALL_TAKESHI)
    setflag(FLAG_HIDE_TARC3_HALL_JOJI)
    setflag(FLAG_HIDE_TARC3_HALL_MARIKO)
    setflag(FLAG_HIDE_TARC3_HALL_KITARO)
    setflag(FLAG_HIDE_TARC3_HALL_AKIE)
    setflag(FLAG_HIDE_TARC3_HALL_TATSUO)
    setflag(FLAG_HIDE_TARC3_HALL_ICHIRO)
    clearflag(FLAG_HIDE_TARC3_LOCKUP_CAST)
    warp(MAP_TARC3_HOLD, 19, 17)
    waitstate
    end
}

// investigation - physical evidence

script tarc3_GozoRoom_EventScript_GozoBody {
    lockall
    goto_if_set(FLAG_TARC3_GOZO_FOUND_BODY, tarc3_GozoRoom_EventScript_GozoBodySeen)
    msgbox(format("Multiple wounds across the chest. Far more than necessary."))
    closemessage
    // EVD_VICIOUS_ATTACK cut
    closemessage
    setflag(FLAG_TARC3_GOZO_FOUND_BODY)
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_GozoBodySeen {
    msgbox(format("Gozo Hatamoto. Struck again and again."))
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_Window {
    lockall
    goto_if_set(FLAG_TARC3_GOZO_FOUND_WINDOW, tarc3_GozoRoom_EventScript_WindowSeen)
    msgbox(format("The cabin windows are firmly shut. They must not have been opened in years."))
    msgbox(format("{FONT_NARROW}Nobody came in this way, and nobody left by it either.", "1_latin_rse_narrow"))
    closemessage
    // EVD_SEALED_WINDOW cut
    closemessage
    setflag(FLAG_TARC3_GOZO_FOUND_WINDOW)
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_WindowSeen {
    msgbox(format("Firmly shut. The one door was the only way in or out of this room."))
    releaseall
    end
}

// searching for the weapon - all three hiding places, or one Magnezone

script tarc3_GozoRoom_EventScript_SearchBed {
    lockall
    goto_if_set(FLAG_TARC3_GOZO_SEARCH_BED, tarc3_GozoRoom_EventScript_SearchBedSeen)
    setflag(FLAG_TARC3_GOZO_SEARCH_BED)
    msgbox(format("Dust, a single slipper, and the whole length of the frame. Nothing else."))
    closemessage
    goto(tarc3_GozoRoom_EventScript_SearchCheck)
}

script tarc3_GozoRoom_EventScript_SearchBedSeen {
    msgbox(format("Nothing under the bed but dust and a slipper."))
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_SearchCouch {
    lockall
    goto_if_set(FLAG_TARC3_GOZO_SEARCH_COUCH, tarc3_GozoRoom_EventScript_SearchCouchSeen)
    setflag(FLAG_TARC3_GOZO_SEARCH_COUCH)
    msgbox(format("Some coins, a pen, but no blade."))
    closemessage
    goto(tarc3_GozoRoom_EventScript_SearchCheck)
}

script tarc3_GozoRoom_EventScript_SearchCouchSeen {
    msgbox(format("Two coins and a pen down the back of the couch. Nothing else."))
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_SearchBin {
    lockall
    goto_if_set(FLAG_TARC3_GOZO_SEARCH_BIN, tarc3_GozoRoom_EventScript_SearchBinSeen)
    setflag(FLAG_TARC3_GOZO_SEARCH_BIN)
    msgbox(format("There are discarded bottles of medicine in here, but no blade."))
    msgbox(format("{FONT_NARROW}Somebody didn't want the others knowing about the medication.", "1_latin_rse_narrow"))
    closemessage
    // EVD_MEDICATION cut
    closemessage
    setflag(FLAG_TARC3_GOZO_FOUND_MEDICATION)
    goto(tarc3_GozoRoom_EventScript_SearchCheck)
}

script tarc3_GozoRoom_EventScript_SearchBinSeen {
    msgbox(format("Only item of note are the discarded medicine bottles."))
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_SearchCheck {
    goto_if_set(FLAG_TARC3_GOZO_FOUND_WEAPON, tarc3_GozoRoom_EventScript_SearchEnd)
    goto_if_unset(FLAG_TARC3_GOZO_SEARCH_BED, tarc3_GozoRoom_EventScript_SearchEnd)
    goto_if_unset(FLAG_TARC3_GOZO_SEARCH_COUCH, tarc3_GozoRoom_EventScript_SearchEnd)
    goto_if_unset(FLAG_TARC3_GOZO_SEARCH_BIN, tarc3_GozoRoom_EventScript_SearchEnd)
    delay(20)
    msgbox(format("{FONT_NARROW}The bed, the couch and the bin. That is everywhere a blade could be in this room.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}There is no weapon in here. He could not have done this to himself and then hidden it.", "1_latin_rse_narrow"))
    closemessage
    // EVD_NO_WEAPON cut
    closemessage
    setflag(FLAG_TARC3_GOZO_FOUND_WEAPON)
    goto(tarc3_GozoRoom_EventScript_SearchEnd)
}

script tarc3_GozoRoom_EventScript_SearchEnd {
    releaseall
    end
}

// pokemon evidence interaction. see tarc3_EventScript_FollowerMagnezone for context

script tarc3_GozoRoom_EventScript_OfferMagnezoneSearch {
    goto_if_set(FLAG_TARC3_GOZO_FOUND_WEAPON, tarc3_EventScript_OfferEnd)
    setvar(VAR_0x8004, SPECIES_MAGNEZONE)
    specialvar(VAR_RESULT, DoesPlayerPartyContainSpecies)
    goto_if_eq(VAR_RESULT, FALSE, tarc3_EventScript_OfferEnd)
    msgbox(format("{FONT_NARROW}The blade did not walk out of a locked room.\pMagnezone would draw steel out of anywhere in here.", "1_latin_rse_narrow"))
    msgbox(format("Have Magnezone sweep the room for the knife?"), MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, NO, tarc3_EventScript_OfferEnd)
    goto(tarc3_GozoRoom_EventScript_FollowerMagnezoneSearch)
}

script tarc3_GozoRoom_EventScript_OfferStoutlandCrumbs {
    goto_if_set(FLAG_TARC3_GOZO_FOUND_RESIDUE, tarc3_EventScript_OfferEnd)
    setvar(VAR_0x8004, SPECIES_STOUTLAND)
    specialvar(VAR_RESULT, DoesPlayerPartyContainSpecies)
    goto_if_eq(VAR_RESULT, FALSE, tarc3_EventScript_OfferEnd)
    msgbox(format("{FONT_NARROW}Bread tells you nothing by looking at it.\pStoutland's nose is another matter.", "1_latin_rse_narrow"))
    msgbox(format("Have Stoutland read the crumbs?"), MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, NO, tarc3_EventScript_OfferEnd)
    goto(tarc3_GozoRoom_EventScript_FollowerStoutlandResidue)
}

script tarc3_GozoRoom_EventScript_FollowerMagnezoneSearch {
    goto_if_set(FLAG_TARC3_GOZO_FOUND_WEAPON, tarc3_EventScript_FollowerHookEnd)
    setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_SPECIES(MAGNEZONE))
    call(tarc3_GozoRoom_EventScript_HelperMonEnter)
    playmoncry(SPECIES_MAGNEZONE, CRY_MODE_ENCOUNTER)
    waitmoncry
    applymovement(LOCALID_GOZOROOM_HELPER_MON, moves(walk_right, walk_in_place_fast_up, walk_in_place_fast_left, walk_in_place_fast_down, walk_in_place_fast_right))
    waitmovement(0)
    delay(20)
    msgbox(format("Magnezone used its magnets to try and find the knife!"))
    msgbox(format("But nothing was found."))
    closemessage
    // EVD_NO_WEAPON cut
    closemessage
    applymovement(LOCALID_GOZOROOM_HELPER_MON, moves(walk_left))
    waitmovement(0)
    call(tarc3_GozoRoom_EventScript_HelperMonExit)
    setflag(FLAG_TARC3_GOZO_FOUND_WEAPON)
    goto(tarc3_EventScript_FollowerHandled)
}

script tarc3_GozoRoom_EventScript_FollowerStoutlandSniff {
    goto_if_set(FLAG_TARC3_GOZO_FOUND_RESIDUE, tarc3_EventScript_FollowerHookEnd)
    goto_if_set(FLAG_TARC3_GOZO_FOUND_CRUMBS, tarc3_GozoRoom_EventScript_FollowerStoutlandResidue)
    setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_SPECIES(STOUTLAND))
    call(tarc3_GozoRoom_EventScript_HelperMonEnter)
    playmoncry(SPECIES_STOUTLAND, CRY_MODE_ENCOUNTER)
    waitmoncry
    applymovement(LOCALID_GOZOROOM_HELPER_MON, moves(walk_in_place_fast_left, walk_in_place_fast_right, walk_in_place_fast_down, walk_in_place_fast_down))
    waitmovement(0)
    delay(20)
    msgbox(format("Stoutland puts its nose to the carpet and stops dead, facing the doorway.\pIt can sniff out a clue!"))
    closemessage
    call(tarc3_GozoRoom_EventScript_HelperMonExit)
    goto(tarc3_EventScript_FollowerHandled)
}

// once the crumbs are documented, Stoutland can tell what is on them

script tarc3_GozoRoom_EventScript_FollowerStoutlandResidue {
    setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_SPECIES(STOUTLAND))
    call(tarc3_GozoRoom_EventScript_HelperMonEnter)
    playmoncry(SPECIES_STOUTLAND, CRY_MODE_ENCOUNTER)
    waitmoncry
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
    waitmovement(0)
    applymovement(LOCALID_GOZOROOM_HELPER_MON, moves(walk_down * 2, walk_in_place_fast_down, walk_in_place_fast_down))
    waitmovement(0)
    delay(20)
    msgbox(format("Stoutland works its nose over the breadcrumbs and sneezes."))
    closemessage
    msgbox(format("{FONT_NARROW}There is a fine black dust worked through them.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_DARK_RESIDUE)
    closemessage
    applymovement(LOCALID_GOZOROOM_HELPER_MON, moves(walk_up * 2))
    waitmovement(0)
    call(tarc3_GozoRoom_EventScript_HelperMonExit)
    setflag(FLAG_TARC3_GOZO_FOUND_RESIDUE)
    goto(tarc3_EventScript_FollowerHandled)
}

script tarc3_GozoRoom_EventScript_EvdCrumbs {
    lockall
    goto_if_set(FLAG_TARC3_GOZO_FOUND_CRUMBS, tarc3_GozoRoom_EventScript_EvdCrumbsSeen)
    msgbox(format("Crumbs of bread, pressed into the blood by the door."))
    msgbox(format("{FONT_NARROW}Somebody stood here with bread in their hand. Gozo never touched the stuff.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_BREADCRUMBS)
    closemessage
    setflag(FLAG_TARC3_GOZO_FOUND_CRUMBS)
    call(tarc3_GozoRoom_EventScript_OfferStoutlandCrumbs)
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_EvdCrumbsSeen {
    msgbox(format("Breadcrumbs trodden into the blood, a step outside the door."))
    call(tarc3_GozoRoom_EventScript_OfferStoutlandCrumbs)
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_EvdCarpet {
    lockall
    goto_if_set(FLAG_TARC3_GOZO_FOUND_CARPET, tarc3_GozoRoom_EventScript_EvdCarpetSeen)
    msgbox(format("The carpet where the garland was lying is bare. Around it the blood is thin and streaked."))
    msgbox(format("{FONT_NARROW}Wiped. And a step through that doorway it hasn't been touched at all.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}Somebody cleaned this side of the door, and only this side.", "1_latin_rse_narrow"))
    closemessage
    // EVD_CLEAN_CARPET cut
    closemessage
    setflag(FLAG_TARC3_GOZO_FOUND_CARPET)
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_EvdCarpetSeen {
    msgbox(format("Carpet wiped clean outside the door. Inside it, untouched."))
    releaseall
    end
}

// investigation - the door itself

script tarc3_GozoRoom_EventScript_EvdDoorframe {
    lockall
    goto_if_set(FLAG_TARC3_GOZO_FOUND_FRAME, tarc3_GozoRoom_EventScript_EvdDoorframeSeen)
    msgbox(format("Blood across the doorframe, thrown high and wide. Chest height, and above it."))
    msgbox(format("{FONT_NARROW}This door was standing open when that landed.\pA closed door cannot be painted on its own frame.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_GOZO_FOUND_FRAME)
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_EvdDoorframeSeen {
    msgbox(format("Blood on the frame itself. The door was open when he was cut."))
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_EvdLatch {
    lockall
    goto_if_set(FLAG_TARC3_GOZO_FOUND_LATCH, tarc3_GozoRoom_EventScript_EvdLatchSeen)
    msgbox(format("A door lock, set into the inner face of the door. It turns without resistance."))
    msgbox(format("{FONT_NARROW}From the corridor, this door requires Suzuki's key.\pFrom in here, it requires the slip of a thumb.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_GOZO_FOUND_LATCH)
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_EvdLatchSeen {
    msgbox(format("The latch on the inner face. No key is needed from this side."))
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_EvdTrail {
    lockall
    goto_if_set(FLAG_TARC3_GOZO_FOUND_TRAIL, tarc3_GozoRoom_EventScript_EvdTrailSeen)
    msgbox(format("A smear runs from the threshold to the place where he came to rest."))
    msgbox(format("{FONT_NARROW}Not a drag mark. Too even, and nothing has pooled at the door.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}He crossed this floor on his own feet, already bleeding.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_GOZO_FOUND_TRAIL)
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_EvdTrailSeen {
    msgbox(format("The trail leads inward, from the doorway to the body."))
    releaseall
    end
}

// investigation - Suzuki

script tarc3_GozoRoom_EventScript_Suzuki {
    lock
    faceplayer
    goto_if_unset(FLAG_TARC3_REFLECT_GOZO_SUZUKI_1, tarc3_GozoRoom_EventScript_SuzukiBeat1)
    goto_if_unset(FLAG_TARC3_REFLECT_GOZO_SUZUKI_2, tarc3_GozoRoom_EventScript_SuzukiBeat2)
    goto_if_unset(FLAG_TARC3_REFLECT_GOZO_SUZUKI_3, tarc3_GozoRoom_EventScript_SuzukiBeat3)
    setspeaker("Suzuki")
    msgbox(format("I have told you everything I know, and it has not helped him."))
    setspeaker(NULL)
    release
    end
}

script tarc3_GozoRoom_EventScript_EvdGarland {
    goto_if_set(FLAG_TARC3_GOZO_FOUND_GARLAND, tarc3_GozoRoom_EventScript_EvdCarpet)
    lockall
    msgbox(format("A garland is lying in the corridor a step from the door."))
    msgbox(format("{FONT_NARROW}Not a mark on it. Amongst the blood spilled here, this came away clean.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_DROPPED_FLOWER)
    closemessage
    call(tarc3_GozoRoom_EventScript_ClearEvidence)
    special(DrawWholeMapView)
    releaseall
    end
}

script tarc3_GozoRoom_EventScript_SuzukiBeat1 {
    setspeaker("Suzuki")
    msgbox(format("Gozo must have invited the assailant into his cabin.\pBut we found the door locked, and there was no one else in the room.\pHow could that be?"))
    setspeaker(NULL)
    closemessage
    setflag(FLAG_TARC3_REFLECT_GOZO_SUZUKI_1)
    goto(tarc3_GozoRoom_EventScript_SuzukiReflectEnd)
}

script tarc3_GozoRoom_EventScript_SuzukiBeat2 {
    setspeaker("Suzuki")
    msgbox(format("There is one spare key to this cabin, and it has been in my pocket since we sailed."))
    msgbox(format("Gozo's room requires extra security.\pOther cabins can be entered freely."))
    setspeaker(NULL)
    closemessage
    msgbox(format("{FONT_NARROW}From the corridor, then. But he was inside it.", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}I should look at the inner face of that door.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_GOZO_SUZUKI_2)
    goto(tarc3_GozoRoom_EventScript_SuzukiReflectEnd)
}

script tarc3_GozoRoom_EventScript_SuzukiBeat3 {
    setspeaker("Suzuki")
    msgbox(format("I passed this door a little over half an hour ago."))
    msgbox(format("The corridor was empty. There was nothing on the floor at all, except that flower."))
    setspeaker(NULL)
    closemessage
    giveevidence(EVD_DROPPED_FLOWER)
    closemessage
    goto(tarc3_GozoRoom_EventScript_SuzukiReflect3)
}

script tarc3_GozoRoom_EventScript_SuzukiReflect3 {
    setspeaker(NULL)
    message(format("{FONT_NARROW}He walked past all of it. What was he actually looking at?", "1_latin_rse_narrow"))
    waitmessage
    dynmultipush("Garland was there first", 1)
    dynmultipush("He should have knocked", 2)
    dynmultipush("Nobody heard a sound", 3)
    dynmultistack(0, 0, TRUE, 3, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 1:
            goto(tarc3_GozoRoom_EventScript_SuzukiReflect3Flower)
        default:
            goto(tarc3_GozoRoom_EventScript_SuzukiReflect3Irrelevant)
    }
}

script tarc3_GozoRoom_EventScript_SuzukiReflect3Flower {
    msgbox(format("{FONT_NARROW}Lying there half an hour before anyone knew he was dead.\pTakeshi's garland, on the floor, waiting to be found.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_GOZO_SUZUKI_3)
    goto(tarc3_GozoRoom_EventScript_SuzukiReflectEnd)
}

script tarc3_GozoRoom_EventScript_SuzukiReflect3Irrelevant {
    msgbox(format("{FONT_NARROW}Perhaps. But that isn't what he walked past.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_GOZO_SUZUKI_3)
    goto(tarc3_GozoRoom_EventScript_SuzukiReflectEnd)
}

script tarc3_GozoRoom_EventScript_SuzukiReflectEnd {
    release
    end
}

// investigation - the family in the corridor

script tarc3_GozoRoom_EventScript_Takeshi {
    lock
    faceplayer
    setspeaker("Takeshi")
    msgbox(format("I was in this corridor before dinner. He asked me to come to his cabin."))
    msgbox(format("We spoke. Then I went back to my own room and sat there until Suzuki called us.\pHe was alive when I closed that door behind me."))
    msgbox(format("...I know how that sounds, standing here."))
    setspeaker(NULL)
    release
    end
}

script tarc3_GozoRoom_EventScript_Natsue {
    lock
    faceplayer
    setspeaker("Natsue")
    msgbox(format("I pinned that garland to Takeshi's jacket myself."))
    msgbox(format("Comfey grew it on our island. There isn't another one like it aboard this ship."))
    msgbox(format("And it was lying on the floor outside my grandfather's door."))
    setspeaker(NULL)
    release
    end
}

script tarc3_GozoRoom_EventScript_Joji {
    lock
    faceplayer
    setspeaker("Joji")
    msgbox(format("Where is the knife? That is the only part I can't get past."))
    msgbox(format("I travel with my own set. Eight blades, in a case, in my cabin."))
    setspeaker(NULL)
    release
    end
}

script tarc3_GozoRoom_EventScript_Mariko {
    lock
    faceplayer
    setspeaker("Mariko")
    msgbox(format("Well? You wanted to look. Say something useful."))
    msgbox(format("...I still need time to process."))
    setspeaker(NULL)
    release
    end
}

script tarc3_GozoRoom_EventScript_Kitaro {
    lock
    faceplayer
    setspeaker("Kitaro")
    msgbox(format("We're hours from any harbour, and the set on the bridge only reaches the coast station."))
    msgbox(format("Everyone scattered after the ceremony. Cabins, the galley, the deck.\pI couldn't tell you where a single person was before dinner."))
    msgbox(format("Nobody should be walking this ship alone tonight."))
    setspeaker(NULL)
    release
    end
}

script tarc3_GozoRoom_EventScript_Akie {
    lock
    faceplayer
    setspeaker("Akie")
    msgbox(format("Don't. I know what I said, and I'm not taking it back."))
    msgbox(format("The door was locked and the key was in Suzuki's pocket.\pWho else was in that room?"))
    msgbox(format("...Somebody in this corridor is a great deal richer than they were an hour ago."))
    setspeaker(NULL)
    release
    end
}

script tarc3_GozoRoom_EventScript_Tatsuo {
    lock
    faceplayer
    setspeaker("Tatsuo")
    msgbox(format("Terrible business. Truly."))
    msgbox(format("He wrote a will, you know. The old man knew he was going to pass sooner or later."))
    msgbox(format("Every person standing here is doing the same arithmetic.\pI'm only the one saying it out loud."))
    setspeaker(NULL)
    release
    end
}

script tarc3_GozoRoom_EventScript_Ichiro {
    lock
    faceplayer
    setspeaker("Ichiro")
    msgbox(format("I'm sorry. I've never seen anything like that."))
    msgbox(format("I was in my cabin. Drawing.\pI didn't hear a thing until Suzuki started shouting."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}He hasn't looked at the body once. He's watching the doorway.", "1_latin_rse_narrow"))
    release
    end
}

script tarc3_GozoRoom_OnLoad {
    setflag(FLAG_HIDE_TARC3_GOZOROOM_HELPER_MON)
    if (var(VAR_TARC3_ACT1) == TARC3_ACT1_THE_BODY) {
        call(tarc3_GozoRoom_EventScript_HideRoom)
    }
    if (flag(FLAG_TARC3_GOZO_FOUND_GARLAND) == TRUE) {
        setmetatile(8, 11, 0x071, FALSE)
    }
    end
}

