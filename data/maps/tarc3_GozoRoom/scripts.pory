script tarc3_GozoRoom_EventScript_HelperMonEnter {
    hidefollower
    clearflag(FLAG_HIDE_TARC3_GOZOROOM_HELPER_MON)
    addobject(LOCALID_GOZOROOM_HELPER_MON)
    delay(20)
    return
}

script tarc3_GozoRoom_EventScript_HelperMonExit {
    delay(20)
    setflag(FLAG_HIDE_TARC3_GOZOROOM_HELPER_MON)
    removeobject(LOCALID_GOZOROOM_HELPER_MON)
    delay(20)
    return
}
