mapscripts tarc3_Hold_MapScripts {
    MAP_SCRIPT_ON_LOAD: tarc3_Hold_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TARC3_FLORIO_INTRO, 5: tarc3_Hold_EventScript_Arrival
        VAR_TARC3_ACT1, TARC3_ACT1_JAIL_TAKESHI: tarc3_Hold_EventScript_JailTakeshi
        VAR_TARC3_ACT2, TARC3_ACT2_HOLD_SEARCH: tarc3_Hold_EventScript_TakeshiGone
    ]
}

script tarc3_Hold_OnLoad {
    setflag(FLAG_HIDE_TARC3_COMFEY)
    if (var(VAR_TARC3_ACT2) != TARC3_ACT2_HOLD_SEARCH) {
        setflag(FLAG_HIDE_TARC3_HOLD2_CAST)
    }
    if (var(VAR_TARC3_ACT2) < TARC3_ACT2_TO_ELECTRICAL) {
        setmetatile(9, 19, 0x0E8, FALSE)
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_ROOM_SETTLES) {
        setmetatile(17, 20, 0x07A, FALSE)
    } else {
        setmetatile(31, 20, 0x024, TRUE)
    }
    end
}

script tarc3_Hold_EventScript_Arrival {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    delay(30)
    setspeaker("Natsue")
    msgbox(format("The hold isn't much to look at, I'm afraid."))
    msgbox(format("The rest of the family are upstairs.\pI'll show you to your room first."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setflag(FLAG_HIDE_TARC3_HOLD_NATSUE)
    setflag(FLAG_HIDE_TARC3_HOLD_RAN)
    call(tarc3_EventScript_Act1Setup)
    setvar(VAR_TARC3_FLORIO_INTRO, 6)
    warp(MAP_TARC3_MAIN_DECK, 28, 11)
    waitstate
    end
}

// CS6

script tarc3_Hold_EventScript_JailTakeshi {
    lockall
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_HOLD_MARIKO_LOCKUP, moves(walk_down * 2, face_right))
    applymovement(LOCALID_HOLD_TATSUO_LOCKUP, moves(walk_down * 2, face_left))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_HOLD_TAKESHI_LOCKUP, moves(walk_down, face_down))
    waitmovement(0)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_down * 2, walk_left))
    waitmovement(0)
    delay(20)
    setspeaker("Mariko")
    msgbox(format("The garland was on the floor outside that door.\pIt was there before any of us knew he was dead."))
    setspeaker("Tatsuo")
    msgbox(format("Natsue pinned it to your lapel this afternoon."))
    delay(40)
    msgbox(format("I saw her do it!"))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Tatsuo")
    msgbox(format("You'd have to be an idiot to drop it right outside his door."))
    applymovement(LOCALID_HOLD_TAKESHI_LOCKUP, moves(walk_in_place_slow_right))
    waitmovement(0)
    setspeaker("Takeshi")
    msgbox(format("I didn't drop it there.\pI lost it somewhere... I don't know where."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_HOLD_JOJI_LOCKUP, moves(walk_in_place_slow_right))
    waitmovement(0)
    setspeaker("Joji")
    msgbox(format("This is a storage hold. We are not a police force."))
    setspeaker("Mariko")
    msgbox(format("I'm sure we could request one. Father had contacts."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_TAKESHI_LOCKUP, moves(face_up))
    waitmovement(0)
    delay(20)
    setspeaker("Takeshi")
    msgbox(format("Don't.\pI'll go in on my own.\pI'd rather that, than have you all stare at me like this."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_HOLD_TAKESHI_LOCKUP, moves(face_down))
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_HOLD_TAKESHI_LOCKUP, moves(walk_down))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_HOLD_TAKESHI_LOCKUP)
    delay(30)
    applymovement(LOCALID_HOLD_SUZUKI_LOCKUP, moves(walk_down, walk_right * 2, walk_down))
    waitmovement(0)
    delay(20)
    playse(SE_BANG)
    delay(30)
    setspeaker("Suzuki")
    msgbox(format("It bolts from this side only. There is no handle on the inside of that door."))
    setspeaker(NULL)
    closemessage
    applymovement(LOCALID_HOLD_SUZUKI_LOCKUP, moves(walk_up))
    waitmovement(0)
    delay(60)
    setspeaker("Suzuki")
    msgbox(format("While you are all in one place... There is a matter I am obliged to raise."))
    msgbox(format("The master wrote a will.\pHe left everything to Natsue.\pAll assets. All authority."))
    msgbox(format("And the man she chose would lead the Corporation."))
    setspeaker(NULL)
    closemessage
    delay(20)
    playse(SE_PIN)
    applymovement(LOCALID_HOLD_MARIKO_LOCKUP, moves(emote_exclamation_mark))
    applymovement(LOCALID_HOLD_AKIE_LOCKUP, moves(emote_exclamation_mark))
    applymovement(LOCALID_HOLD_TATSUO_LOCKUP, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_HOLD_AKIE_LOCKUP, moves(walk_down, face_left))
    waitmovement(0)
    applymovement(LOCALID_HOLD_TATSUO_LOCKUP, moves(face_right))
    waitmovement(0)
    delay(20)
    setspeaker("Tatsuo")
    msgbox(format("Tch..."))
    setspeaker("Akie")
    msgbox(format("Say it. You've been waiting all evening to say it."))
    setspeaker("Tatsuo")
    msgbox(format("You think a single one of us would be on this boat if that will didn't exist?"))
    msgbox(format("I married into this family to inherit something.\pThere.\pI said it."))
    msgbox(format("Just like Mr. Zaiki's boy did."))
    setspeaker(NULL)
    closemessage
    delay(30)
    setspeaker("Akie")
    msgbox(format("You..!\pI can't believe you!\pGet away from me!"))
    setspeaker("Tatsuo")
    msgbox(format("Gladly. I'll be on the outer deck."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_TATSUO_LOCKUP, moves(walk_up * 4, walk_right))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_HOLD_TATSUO_LOCKUP)
    delay(90)
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_HOLD_MARIKO_LOCKUP)
    removeobject(LOCALID_HOLD_KITARO_LOCKUP)
    removeobject(LOCALID_HOLD_JOJI_LOCKUP)
    removeobject(LOCALID_HOLD_AKIE_LOCKUP)
    removeobject(LOCALID_HOLD_ICHIRO_LOCKUP)
    removeobject(LOCALID_HOLD_SUZUKI_LOCKUP)
    applymovement(LOCALID_CAMERA, moves(walk_up * 2, walk_right))
    waitmovement(0)
    special(RemoveCameraObject)
    fadescreen(FADE_FROM_BLACK)
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    setspeaker("{RIVAL}")
    msgbox(format("I suggest we return to our cabin. We must review the facts."))
    setspeaker(NULL)
    closemessage
    delay(30)
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_HOLD_RAN_LOCKUP)
    setflag(FLAG_HIDE_TARC3_LOCKUP_CAST)
    clearflag(FLAG_HIDE_TARC3_CABIN_RAN_NIGHT)
    setvar(VAR_TARC3_ACT1, TARC3_ACT1_NIGHT_RECAP)
    warp(MAP_TARC3_CABINS, 49, 20)
    waitstate
    end
}

script tarc3_Hold_EventScript_EvdManifest {
    // this evidence is no longer used
    lockall
    if (var(VAR_TARC3_ACT1) < TARC3_ACT1_COMPLETE) {
        msgbox(format("The passenger manifest, hung by the stairs in Kitaro's handwriting."))
        releaseall
        end
    }
    goto_if_set(FLAG_TARC3_HOLD_FOUND_MANIFEST, tarc3_Hold_EventScript_EvdManifestSeen)
    msgbox(format("The passenger manifest, hung by the stairs in Kitaro's handwriting."))
    msgbox(format("{FONT_NARROW}Family, one steward, one cook. The crew are berthed forward.", "1_latin_rse_narrow"))
    closemessage
    // EVD_PASSENGER_MANIFEST cut
    closemessage
    setflag(FLAG_TARC3_HOLD_FOUND_MANIFEST)
    releaseall
    end
}

script tarc3_Hold_EventScript_EvdManifestSeen {
    msgbox(format("The manifest. Family, one steward, one cook, and nobody else aft of the bridge."))
    releaseall
    end
}

// investigation - the storage door

script tarc3_Hold_EventScript_StorageDoor {
    lockall
    if (var(VAR_TARC3_ACT2) < TARC3_ACT2_ROOM_SETTLES) {
        msgbox(format("A heavy storage door, bolted from this side. There is no handle on the other one."))
        releaseall
        end
    }
    if (flag(FLAG_TARC3_HOLD_FOUND_DOOR) == TRUE) {
        msgbox(format("The bolt slid back clean. Nobody broke this door open."))
        releaseall
        end
    }
    msgbox(format("The bolt is drawn back and resting in its keeper. Not bent, not forced, not a mark on the plate."))
    msgbox(format("{FONT_NARROW}(It only works from out here. No handle on the inside, and Suzuki shot it across in front of everybody.)", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}(So somebody stood where I'm standing and slid it open again.)", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_OPEN_STORAGE_DOOR)
    closemessage
    setflag(FLAG_TARC3_HOLD_FOUND_DOOR)
    releaseall
    end
}

script tarc3_Hold_EventScript_ElectricalDoor {
    // no longer used
    goto_if_ge(VAR_TARC3_ACT2, TARC3_ACT2_TO_ELECTRICAL, tarc3_Hold_EventScript_ElectricalDoorOpen)
    lockall
    msgbox(format("The electrical room door is locked."))
    releaseall
    end
}

script tarc3_Hold_EventScript_ElectricalDoorOpen {
    end
}

// CS8

script tarc3_Hold_EventScript_TakeshiGone {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    delay(40)
    playse(SE_PIN)
    applymovement(LOCALID_HOLD_KITARO_SEARCH, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    setspeaker("Ichiro")
    msgbox(format("Huh? The storage door is wide open."))
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_SUZUKI_SEARCH, moves(walk_down))
    waitmovement(0)
    delay(40)
    setspeaker("Suzuki")
    msgbox(format("Empty.\pThere's nowhere in here to hide."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_SUZUKI_SEARCH, moves(walk_up, face_left))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_HOLD_KITARO_SEARCH, moves(walk_in_place_fast_down))
    waitmovement(0)
    setspeaker("Kitaro")
    msgbox(format("The bolt isn't broken. Look at it."))
    msgbox(format("It's been drawn back. Slid open, neat as anything."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_MARIKO_SEARCH, moves(walk_in_place_fast_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("There. That is your answer."))
    msgbox(format("He let himself out, he went up on that deck, and he killed Tatsuo."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_HOLD_SUZUKI_SEARCH, moves(face_up))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("Mariko.\pThat door has no handle on the inside."))
    msgbox(format("I bolted it myself. He could not have reached it."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Mariko")
    msgbox(format("Or... You didn't close it correctly."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Suzuki")
    msgbox(format("Forgive me, Mariko. But I did bolt the door myself.\pEveryone had watched me."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}Could someone outside this room have opened it for him..?", "1_latin_rse_narrow"))
    closemessage
    delay(30)
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_HOLD_SUZUKI_SEARCH)
    removeobject(LOCALID_HOLD_NATSUE_SEARCH)
    removeobject(LOCALID_HOLD_COMFEY_SEARCH)
    removeobject(LOCALID_HOLD_MARIKO_SEARCH)
    removeobject(LOCALID_HOLD_KITARO_SEARCH)
    removeobject(LOCALID_HOLD_AKIE_SEARCH)
    removeobject(LOCALID_HOLD_JOJI_SEARCH)
    removeobject(LOCALID_HOLD_ICHIRO_SEARCH)
    setobjectxy(LOCALID_HOLD_RAN_SEARCH, 17, 19)
    applymovement(LOCALID_HOLD_RAN_SEARCH, moves(face_up))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    fadescreen(FADE_FROM_BLACK)
    delay(30)
    setspeaker("{RIVAL}")
    msgbox(format("They will argue about this for an hour, and arrive nowhere."))
    msgbox(format("You have already told them how Tatsuo died. They are not ready to hear who drew that bolt."))
    msgbox(format("Upstairs, then. All of them, in one room, where I can watch their faces while I ask it."))
    setspeaker(NULL)
    closemessage
    delay(30)
    fadescreen(FADE_TO_BLACK)
    setflag(FLAG_HIDE_TARC3_HOLD2_CAST)
    removeobject(LOCALID_HOLD_RAN_SEARCH)
    goto(tarc3_EventScript_ToDiningRoom)
}

script tarc3_Hold_EventScript_Ran {
    lock
    faceplayer
    setspeaker("{RIVAL}")
    msgbox(format("The stairs are there, {PLAYER} Edgeworth. They are all waiting above."))
    setspeaker(NULL)
    release
    end
}

script tarc3_Hold_EventScript_EvdDeckPlan {
    lockall
    if (var(VAR_TARC3_ACT1) < TARC3_ACT1_JAIL_TAKESHI) {
        msgbox(format("A deck plan of the lower level."))
        releaseall
        end
    }
    goto_if_set(FLAG_TARC3_HOLD_FOUND_DECKPLAN, tarc3_Hold_EventScript_EvdDeckPlanSeen)
    msgbox(format("A deck plan pinned to the wall. The storeroom, the electrical room, and the corridor between them are all on this level."))
    msgbox(format("{FONT_NARROW}The storeroom and the breaker are barely thirty paces apart.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_THE_HOLD_ADJOINS)
    closemessage
    setflag(FLAG_TARC3_HOLD_FOUND_DECKPLAN)
    releaseall
    end
}

script tarc3_Hold_EventScript_EvdDeckPlanSeen {
    msgbox(format("The deck plan. Storeroom and electrical room, side by side on the same level."))
    releaseall
    end
}
