mapscripts tarc3_MainDeck_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: tarc3_MainDeck_OnTransition
    MAP_SCRIPT_ON_LOAD: tarc3_MainDeck_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TARC3_FLORIO_INTRO, 6: tarc3_MainDeck_EventScript_ShowRoom
        VAR_TARC3_ACT1, TARC3_ACT1_DINNER: tarc3_MainDeck_EventScript_Dinner
        VAR_TARC3_ACT2, TARC3_ACT2_ROOM_SETTLES: tarc3_MainDeck_EventScript_RoomSettles
        VAR_TARC3_ACT2, TARC3_ACT2_BLACKOUT: tarc3_MainDeck_EventScript_BlackoutReturn
    ]
}

// force blackout during act 2

script tarc3_MainDeck_OnTransition {
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_BLACKOUT && var(VAR_TARC3_ACT2) <= TARC3_ACT2_TO_BATHROOM) {
        if (flag(FLAG_TARC3_MAGNEZONE_FLASH)) {
            setflashlevel(4)
        } else {
            setflashlevel(7)
        }
    }
    end
}

script tarc3_MainDeck_OnLoad {
    setflag(FLAG_HIDE_TARC3_COMFEY)
    if (var(VAR_TARC3_ACT2) == TARC3_ACT2_DECK_DOOR) {
        clearflag(FLAG_HIDE_TARC3_DECKDOOR_CAST)
    } else {
        setflag(FLAG_HIDE_TARC3_DECKDOOR_CAST)
    }
    if (var(VAR_TARC3_ACT2) == TARC3_ACT2_TO_BATHROOM) {
        clearflag(FLAG_HIDE_TARC3_CORRIDOR_RAN)
    } else {
        setflag(FLAG_HIDE_TARC3_CORRIDOR_RAN)
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_TO_ELECTRICAL) {
        clearflag(FLAG_HIDE_TARC3_DINING_ICHIRO_HURT)
        clearflag(FLAG_HIDE_TARC3_DINING_RAN)
        clearflag(FLAG_HIDE_TARC3_DINING_NATSUE)
    } else {
        setflag(FLAG_HIDE_TARC3_DINING_ICHIRO_HURT)
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_SEARCH_TAKESHI) {
        clearflag(FLAG_HIDE_TARC3_DINING_KITARO)
        clearflag(FLAG_HIDE_TARC3_DINING_MARIKO)
        clearflag(FLAG_HIDE_TARC3_DINING_AKIE)
        clearflag(FLAG_HIDE_TARC3_DINING_JOJI)
        clearflag(FLAG_HIDE_TARC3_DINING_SUZUKI)
    }
    if (var(VAR_TARC3_ACT2) < TARC3_ACT2_SEARCH_TAKESHI) {
        setmetatile(13, 8, 0x024, TRUE)
        setmetatile(18, 8, 0x024, TRUE)
        setmetatile(23, 8, 0x024, TRUE)
        setmetatile(28, 8, 0x024, TRUE)
        setmetatile(13, 13, 0x0E8, FALSE)
        setmetatile(18, 13, 0x0E8, FALSE)
        setmetatile(23, 13, 0x0E8, FALSE)
    }
    // act three moves the whole room down to Akie's cabin
    if (var(VAR_TARC3_ACT3) >= TARC3_ACT3_GATHERING) {
        setflag(FLAG_HIDE_TARC3_DINING_ICHIRO_HURT)
        setflag(FLAG_HIDE_TARC3_DINING_RAN)
        setflag(FLAG_HIDE_TARC3_DINING_NATSUE)
        setflag(FLAG_HIDE_TARC3_DINING_KITARO)
        setflag(FLAG_HIDE_TARC3_DINING_MARIKO)
        setflag(FLAG_HIDE_TARC3_DINING_AKIE)
        setflag(FLAG_HIDE_TARC3_DINING_JOJI)
        setflag(FLAG_HIDE_TARC3_DINING_SUZUKI)
    }
    end
}

script tarc3_MainDeck_EventScript_CabinDoor {
    goto_if_ge(VAR_TARC3_ACT2, TARC3_ACT2_SEARCH_TAKESHI, tarc3_MainDeck_EventScript_CabinDoorOpen)
    lockall
    msgbox(format("The cabin door is locked."))
    releaseall
    end
}

script tarc3_MainDeck_EventScript_CabinDoorOpen {
    end
}

script tarc3_MainDeck_EventScript_GozoCabinDoor {
    goto_if_ge(VAR_TARC3_ACT1, TARC3_ACT1_THE_BODY, tarc3_GozoRoom_EventScript_EvdDoorframe)
    goto(tarc3_MainDeck_EventScript_CabinDoor)
}

script tarc3_MainDeck_EventScript_ShowRoom {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    delay(20)
    applymovement(LOCALID_MAINDECK_RAN_1, moves(walk_down, walk_left))
    waitmovement(0)
    setspeaker("Natsue")
    msgbox(format("This is your room. Please make yourself at home."))
    msgbox(format("I'll see you later."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_NATSUE_1, moves(walk_left * 11))
    waitmovement(0)
    setflag(FLAG_HIDE_TARC3_MAINDECK_NATSUE)
    removeobject(LOCALID_MAINDECK_NATSUE_1)
    delay(20)
    applymovement(LOCALID_MAINDECK_RAN_1, moves(face_up))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("I will look over the cabin. Go and present yourself to the family."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_RAN_1, moves(walk_down))
    waitmovement(0)
    playse(SE_EXIT)
    delay(20)
    setflag(FLAG_HIDE_TARC3_MAINDECK_RAN)
    removeobject(LOCALID_MAINDECK_RAN_1)
    delay(30)
    setvar(VAR_TARC3_FLORIO_INTRO, 7)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_Mariko {
    lock
    faceplayer
    setspeaker("Mariko")
    if (var(VAR_TARC3_ACT1) < TARC3_ACT1_DEPARTED) {
        msgbox(format("I'm Mariko Hatamoto. My husband handles the company. I handle the family."))
        msgbox(format("You'll find we're not much of a wedding party.\pWe travel together rarely, and never happily."))
        msgbox(format("The last time we were all in one room was a funeral.\pMy brother Shoichi and his wife. An accident, a couple years ago."))
        msgbox(format("We're in much better spirits today. It's a good chance to ask Father about..."))
        msgbox(format("Disregard that! This is a family matter."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("So you met my father on the deck. Everybody does, eventually."))
    msgbox(format("He kept Kitaro waiting eleven years before he approved our marriage.\pEleven. And Natsue was engaged inside a month."))
    msgbox(format("He decides who belongs to this family. He always has."))
    setspeaker(NULL)
    closemessage
    if (!defeated(TRAINER_TARC3_MARIKO)) {
        goto(tarc3_MainDeck_EventScript_MarikoBattle)
    }
    release
    end
}

script tarc3_MainDeck_EventScript_MarikoBattle {
    delay(20)
    setspeaker("Mariko")
    msgbox(format("You've been listening very carefully for a guest.\pI don't answer questions from strangers."))
    msgbox(format("But I'll tell you what I will do.\pShow me you're worth the minutes."))
    setspeaker(NULL)
    closemessage
    setflag(FLAG_TARC3_NO_WHITEOUT)
    trainerbattle_no_intro(TRAINER_TARC3_MARIKO, tarc3_MainDeck_Text_MarikoDefeat)
    clearflag(FLAG_TARC3_NO_WHITEOUT)
    specialvar(VAR_RESULT, GetBattleOutcome)
    goto_if_ne(VAR_RESULT, B_OUTCOME_WON, tarc3_MainDeck_EventScript_MarikoBattleLost)
    delay(20)
    setspeaker("Mariko")
    msgbox(format("...Very well. The minutes are yours."))
    msgbox(format("I stood outside my father's door before dinner. I heard him shouting.\pHe was shouting Takeshi's name."))
    msgbox(format("I don't need to say more than that to you."))
    setspeaker(NULL)
    closemessage
    msgbox(format("{FONT_NARROW}She was at that door. And she has decided, already, what the shouting meant.", "1_latin_rse_narrow"))
    giveevidence(EVD_OVERHEARD_ARGUMENT)
    closemessage
    goto(tarc3_MainDeck_EventScript_MarikoBattleEnd)
}

script tarc3_MainDeck_EventScript_MarikoBattleLost {
    settrainerflag(TRAINER_TARC3_MARIKO)
    delay(20)
    setspeaker("Mariko")
    msgbox(format("As I thought.\pGo and enjoy dinner."))
    setspeaker(NULL)
    closemessage
    goto(tarc3_MainDeck_EventScript_MarikoBattleEnd)
}

script tarc3_MainDeck_EventScript_MarikoBattleEnd {
    special(HealPlayerParty)
    delay(20)
    release
    end
}

text tarc3_MainDeck_Text_MarikoDefeat {
    format("Then you were worth the minutes.")
}


script tarc3_MainDeck_EventScript_Akie {
    lock
    faceplayer
    setspeaker("Akie")
    if (var(VAR_TARC3_ACT1) < TARC3_ACT1_DEPARTED) {
        msgbox(format("Akie. Natsue's sister, before you ask, and no, we're nothing alike."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("Yes? No, it's nothing. Family business."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_AKIE, moves(face_left))
    waitmovement(0)
    msgbox(format("She lowers her voice and turns back to Mariko. Only fragments carry.", "1_latin_rse_narrow"))
    msgbox(format("...everything goes to... not to the eldest...)", "1_latin_rse_narrow"))
    release
    end
}

script tarc3_MainDeck_EventScript_Suzuki {
    lock
    faceplayer
    setspeaker("Suzuki")
    if (var(VAR_TARC3_ACT1) < TARC3_ACT1_DEPARTED) {
        msgbox(format("Good afternoon. Kenji Suzuki. I look after Gozo and the family."))
        msgbox(format("Dinner is not far away. You are both expected, whatever anyone tells you otherwise."))
        msgbox(format("The galley is through there, the cabins behind you.\pThe stairs will take you to the hold."))
        msgbox(format("The crew keep to the bridge and their own berths.\pFor this voyage, the ship belongs to the family and nobody else."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("I heard about the deck. Apologies. Gozo speaks his mind with ruthless efficiency.\pIt's how he conducts his business, too."))
    msgbox(format("Lately, Gozo has been considering his legacy. His assets, his investments.\pWhat he wants to grow... and cut loose."))
    msgbox(format("The young man with the sketchbook is not family, before you ask.\pIchiro is Natsue's childhood friend. He has always supported her."))
    msgbox(format("Gozo paid for his studies. Art school - drawing is his passion."))
    msgbox(format("...Gozo tends to feel owed, when he invests in a person."))
    setspeaker(NULL)
    closemessage
    goto(tarc3_MainDeck_EventScript_SuzukiReflect)
}

script tarc3_MainDeck_EventScript_SuzukiReflect {
    goto_if_set(FLAG_TARC3_REFLECT_SUZUKI, tarc3_MainDeck_EventScript_SuzukiReflectEnd)
    setspeaker(NULL)
    message(format("{FONT_NARROW}He chose every one of those words. What should I jot down?", "1_latin_rse_narrow"))
    waitmessage
    dynmultipush("Ichiro is a gifted artist", 1)
    dynmultipush("Suzuki is very observant", 2)
    dynmultipush("Gozo sponsored Ichiro's education", 3)
    dynmultistack(0, 0, TRUE, 3, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 3:
            goto(tarc3_MainDeck_EventScript_SuzukiReflectSponsorship)
        default:
            goto(tarc3_MainDeck_EventScript_SuzukiReflectIrrelevant)
    }
}

script tarc3_MainDeck_EventScript_SuzukiReflectSponsorship {
    msgbox(format("{FONT_NARROW}Ichiro's whole education came out of Gozo's pocket. And Gozo counts what he's owed.\pThat one goes in the notes.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_SUZUKI)
    giveevidence(EVD_ICHIRO_SPONSORSHIP)
    closemessage
    goto(tarc3_MainDeck_EventScript_SuzukiReflectEnd)
}

script tarc3_MainDeck_EventScript_SuzukiReflectIrrelevant {
    msgbox(format("{FONT_NARROW}Probably true. I can't do anything with it, though.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_SUZUKI)
    goto(tarc3_MainDeck_EventScript_SuzukiReflectEnd)
}

script tarc3_MainDeck_EventScript_SuzukiReflectEnd {
    release
    end
}

script tarc3_MainDeck_EventScript_Joji {
    lock
    faceplayer
    setspeaker("Joji")
    if (var(VAR_TARC3_ACT1) < TARC3_ACT1_DEPARTED) {
        msgbox(format("Joji Hatamoto. You might think we're a family of businesspeople.\pI travel the world, cooking only the finest foods."))
        msgbox(format("I run a restaurant back on the mainland. Kalosian cuisine, mostly.\pMy Pokémon assist, of course!"))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("I asked Father what he made of the reception. I spent three days cooking that soup."))
    msgbox(format("He heard the word Kalosian, and that was the end of it.\pHe wouldn't even touch it on Natsue's wedding day."))
    msgbox(format("Not a bite. Not even the bread.\pHe says a Kalosian loaf is too rich. Psh!"))
    msgbox(format("Anyway. Dinner is nearly up, and I won't have it going cold."))
    msgbox(format("Fetch your friend from your cabin and come through together.\pI'm not sending Suzuki round twice."))
    setspeaker(NULL)
    closemessage
    if (!defeated(TRAINER_TARC3_JOJI)) {
        goto(tarc3_MainDeck_EventScript_JojiBattle)
    }
    goto(tarc3_MainDeck_EventScript_JojiReflectEnd)
}

script tarc3_MainDeck_EventScript_JojiBattle {
    delay(20)
    setspeaker("Joji")
    msgbox(format("Before you go. You battle, don't you?"))
    msgbox(format("A kitchen is timing and nothing else, and so is this.\pIndulge me while the soup rests."))
    setspeaker(NULL)
    closemessage
    setflag(FLAG_TARC3_NO_WHITEOUT)
    trainerbattle_no_intro(TRAINER_TARC3_JOJI, tarc3_MainDeck_Text_JojiDefeat)
    clearflag(FLAG_TARC3_NO_WHITEOUT)
    specialvar(VAR_RESULT, GetBattleOutcome)
    goto_if_ne(VAR_RESULT, B_OUTCOME_WON, tarc3_MainDeck_EventScript_JojiBattleLost)
    delay(20)
    setspeaker("Joji")
    msgbox(format("Beautifully done!"))
    msgbox(format("Father wouldn't lend me the money for my restaurant. He bought me a set of knives instead.\pThe cheapest he could find with a name on it."))
    msgbox(format("I even used them when preparing dinner tonight. Spite sharpens beautifully."))
    setspeaker(NULL)
    closemessage
    msgbox(format("{FONT_NARROW}Hmm. A set of chef's knives, stashed in Joji's luggage.", "1_latin_rse_narrow"))
    giveevidence(EVD_KNIVES_COUNTED)
    closemessage
    goto(tarc3_MainDeck_EventScript_JojiBattleEnd)
}

script tarc3_MainDeck_EventScript_JojiBattleLost {
    settrainerflag(TRAINER_TARC3_JOJI)
    delay(20)
    setspeaker("Joji")
    msgbox(format("Timing! I told you.\pSit them down, I'll have them right in a moment."))
    setspeaker(NULL)
    closemessage
    goto(tarc3_MainDeck_EventScript_JojiBattleEnd)
}

script tarc3_MainDeck_EventScript_JojiBattleEnd {
    special(HealPlayerParty)
    delay(20)
    goto(tarc3_MainDeck_EventScript_JojiReflectEnd)
}

text tarc3_MainDeck_Text_JojiDefeat {
    format("Ah! Off the heat, off the heat.")
}


script tarc3_MainDeck_EventScript_JojiReflectEnd {
    release
    end
}

// dinner & investigation

script tarc3_MainDeck_EventScript_Dinner {
    lockall
    setflag(FLAG_HIDE_TARC3_MAINDECK_MARIKO)
    setflag(FLAG_HIDE_TARC3_MAINDECK_AKIE)
    setflag(FLAG_HIDE_TARC3_MAINDECK_SUZUKI)
    setflag(FLAG_HIDE_TARC3_MAINDECK_JOJI)
    removeobject(LOCALID_MAINDECK_MARIKO)
    removeobject(LOCALID_MAINDECK_AKIE)
    removeobject(LOCALID_MAINDECK_SUZUKI)
    removeobject(LOCALID_MAINDECK_JOJI)
    delay(30)
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(face_up))
    waitmovement(0)
    delay(30)
    setspeaker("{RIVAL}")
    msgbox(format("A remarkably silent dinner.\pTwelve people across three tables, and not one of them will speak first."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(face_left))
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_MAINDECK_SUZUKI_DINING, moves(walk_right * 2, face_right))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_MAINDECK_NATSUE_DINING, moves(face_left))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("The second course will be ready shortly. Has Gozo not joined yet?"))
    setspeaker(NULL)
    closemessage
    delay(30)
    clearflag(FLAG_HIDE_TARC3_DINING_TAKESHI)
    addobject(LOCALID_MAINDECK_TAKESHI_DINING)
    delay(30)
    applymovement(LOCALID_MAINDECK_TAKESHI_DINING, moves(walk_right * 7, walk_down, face_right))
    waitmovement(0)
    copyobjectxytoperm(LOCALID_MAINDECK_TAKESHI_DINING)
    applymovement(LOCALID_MAINDECK_NATSUE_DINING, moves(face_up))
    waitmovement(0)
    delay(20)
    setspeaker("Natsue")
    msgbox(format("Takeshi. You've gone completely pale."))
    applymovement(LOCALID_MAINDECK_NATSUE_DINING, moves(walk_in_place_slow_up))
    delay(30)
    msgbox(format("And your garland. When did it come off?"))
    applymovement(LOCALID_MAINDECK_TAKESHI_DINING, moves(walk_in_place_slow_down * 2))
    setspeaker("Takeshi")
    msgbox(format("I don't know. I'm sorry."))
    msgbox(format("I've been in our cabin since I left your grandfather. Sitting. Thinking.\pI didn't notice it was gone."))
    setspeaker(NULL)
    closemessage
    delay(30)
    applymovement(LOCALID_MAINDECK_NATSUE_DINING, moves(face_right))
    applymovement(LOCALID_MAINDECK_TAKESHI_DINING, moves(face_right))
    waitmovement(0)
    setspeaker("{RIVAL}")
    msgbox(format("He does not know when it came off."))
    msgbox(format("On the day of his own wedding.\pOne doesn't need to be a detective to have their curiousity piqued."))
    setspeaker(NULL)
    closemessage
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_up * 5))
    waitmovement(0)
    delay(20)
    playse(SE_PIN)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_down))
    waitmovement(0)
    delay(20)
    setspeaker("Mariko")
    msgbox(format("You say you're a detective..?\pI did have suspicions."))
    msgbox(format("Don't repeat that in front of my father.\pPeople who pry into other people's affairs are contemptible, in his words."))
    closemessage
    applymovement(LOCALID_MAINDECK_KITARO_DINING, moves(face_up))
    waitmovement(0)
    setspeaker("Kitaro")
    msgbox(format("Mariko."))
    setspeaker("Mariko")
    msgbox(format("I'm being kind. He would have said it far worse."))
    setspeaker(NULL)
    closemessage
    delay(40)
    applymovement(LOCALID_CAMERA, moves(walk_down * 5))
    waitmovement(0)
    special(RemoveCameraObject)
    delay(30)
    applymovement(LOCALID_MAINDECK_SUZUKI_DINING, moves(walk_in_place_slow_right))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("Please, talk amongst yourselves.\pI will see if Gozo will join us."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_SUZUKI_DINING, moves(walk_left * 7))
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_TARC3_DINING_SUZUKI)
    removeobject(LOCALID_MAINDECK_SUZUKI_DINING)
    delay(30)
    setvar(VAR_TARC3_ACT1, TARC3_ACT1_DINNER_TABLE)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_EvdPlate {
    lockall
    goto_if_set(FLAG_TARC3_DINING_FOUND_PLATE, tarc3_MainDeck_EventScript_EvdPlateSeen)
    msgbox(format("The setting at the head of the table has not been touched. The bread beside it is whole."))
    msgbox(format("{FONT_NARROW}Gozo won't eat Kalosian food. And he certainly hasn't touched his bread.", "1_latin_rse_narrow"))
    closemessage
    // EVD_UNTOUCHED_PLATE cut
    closemessage
    setflag(FLAG_TARC3_DINING_FOUND_PLATE)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_EvdPlateSeen {
    msgbox(format("Gozo's place setting, still laid and still untouched."))
    releaseall
    end
}

// act 1 dinner conversations

script tarc3_MainDeck_EventScript_DinnerTalkDone {
    if (var(VAR_TARC3_DINNER_TALKED) >= 5) {
        goto(tarc3_MainDeck_EventScript_TheScream)
    }
    release
    end
}

script tarc3_MainDeck_EventScript_DinnerNoExit {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
    waitmovement(0)
    msgbox(format("{FONT_NARROW}Everyone is waiting on Gozo.\pI should talk to the family members to pass the time.", "1_latin_rse_narrow"))
    releaseall
    end
}

script tarc3_MainDeck_EventScript_DiningSuzuki {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_SEARCH_TAKESHI) {
        goto(tarc3_MainDeck_EventScript_SuzukiSearch)
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_BLACKOUT) {
        setspeaker("Suzuki")
        msgbox(format("Nobody is to go wandering.\pThe breaker is below, and I will see to it myself."))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherSuzuki)
    }
    setspeaker("Suzuki")
    msgbox(format("Everything is ready, sir."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_DiningRan {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_SEARCH_TAKESHI) {
        goto(tarc3_MainDeck_EventScript_DiningRanAct3)
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_TO_ELECTRICAL) {
        setspeaker("{RIVAL}")
        msgbox(format("His leg is bound. Natsue has not left his side."))
        msgbox(format("Go, {PLAYER} Edgeworth. The steward is waiting on you to find Takeshi."))
        msgbox(format("I will stay with Ichiro and hold this room together.\pDo not do anything foolish out there."))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_BLACKOUT) {
        setspeaker("{RIVAL}")
        msgbox(format("Stay where I can hear you, {PLAYER} Edgeworth.\pThat corridor is entirely dark."))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_ROOM_SETTLES) {
        setspeaker("{RIVAL}")
        msgbox(format("Every person in this room is pursuing something of their own.\pNot one of them will say what it is."))
        setspeaker(NULL)
        release
        end
    }
    setspeaker("{RIVAL}")
    msgbox(format("They begin sentences and then abandon them.\pIt is maddening."))
    msgbox(format("There is a great deal of ill will in this room. Money does that to a family."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_RAN)) {
        setflag(FLAG_TARC3_DINNER_TALK_RAN)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningNatsue {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_TO_ELECTRICAL) {
        setspeaker("Natsue")
        msgbox(format("We've cleaned the wound up. I've got him.\pPlease find Takeshi!"))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_BLACKOUT) {
        setspeaker("Natsue")
        msgbox(format("I can't see anything.\pIs everyone still here?"))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherNatsue)
    }
    setspeaker("Natsue")
    msgbox(format("Oh... hello.\pTakeshi hasn't said a word since he sat down."))
    msgbox(format("Grandfather asked to speak with him alone.\pThat is never a small thing."))
    msgbox(format("I wish my aunt would stop being so argumentative. At least, pause it for my wedding day."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_NATSUE)) {
        setflag(FLAG_TARC3_DINNER_TALK_NATSUE)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningTakeshi {
    lock
    faceplayer
    setspeaker("Takeshi")
    msgbox(format("...Sorry. I'm poor company tonight."))
    msgbox(format("Gozo knew more about me than I thought.\pBut now... I think I'm at peace. I hope he is too."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_TAKESHI)) {
        setflag(FLAG_TARC3_DINNER_TALK_TAKESHI)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningJoji {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_SEARCH_TAKESHI) {
        setspeaker("Joji")
        msgbox(format("Somebody opened my knife case, {PLAYER}.\pI'd like to know who, before they open it again."))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_BLACKOUT) {
        setspeaker("Joji")
        msgbox(format("Everybody stay by the table.\pThe last thing we need is somebody on the floor in the dark."))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherJoji)
    }
    setspeaker("Joji")
    msgbox(format("Well. Nobody has eaten a thing."))
    msgbox(format("Three days I spent on that consommé.\pNot one spoon lifted."))
    msgbox(format("Even Ichiro here, and he always clears his plate."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_JOJI)) {
        setflag(FLAG_TARC3_DINNER_TALK_JOJI)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningMariko {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_SEARCH_TAKESHI) {
        setspeaker("Mariko")
        msgbox(format("Scorch marks. Wonderful.\pThat narrows it to everyone aboard."))
        msgbox(format("Find Takeshi. Then we can all stop pretending."))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_BLACKOUT) {
        setspeaker("Mariko")
        msgbox(format("Lights - now - of all moments?"))
        msgbox(format("Nobody leaves this room.\pI want to know exactly where every one of you is."))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherMariko)
    }
    setspeaker("Mariko")
    msgbox(format("Hm? Oh. It's you."))
    msgbox(format("I went down to Father's cabin before dinner.\pHe didn't answer. He does that when he's in a mood."))
    msgbox(format("There's an announcement coming when we dock.\pIf you've any sense, you'll be off this ship before it's made."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_MARIKO)) {
        setflag(FLAG_TARC3_DINNER_TALK_MARIKO)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningKitaro {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_SEARCH_TAKESHI) {
        setspeaker("Kitaro")
        msgbox(format("I shouldn't have said that to Joji.\pIn front of everyone, like that."))
        msgbox(format("But somebody in this room did it.\pThat's the part I can't put down."))
        setspeaker(NULL)
        closemessage
        if (defeated(TRAINER_TARC3_KITARO) && !flag(FLAG_TARC3_KITARO_SMEARGLE)) {
            goto(tarc3_MainDeck_EventScript_DiningKitaroSmeargle)
        }
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_BLACKOUT) {
        setspeaker("Kitaro")
        msgbox(format("I don't feel good about this.\pWe should all stay close to one another."))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherKitaro)
    }
    setspeaker("Kitaro")
    msgbox(format("...Three times I've asked to leave the company.\pThree times he's refused me."))
    msgbox(format("I'm no good at it. Everyone knows that.\pHim most of all."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_KITARO)) {
        setflag(FLAG_TARC3_DINNER_TALK_KITARO)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DiningKitaroReflectEnd)
}

script tarc3_MainDeck_EventScript_DiningKitaroReflectEnd {
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningAkie {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_SEARCH_TAKESHI) {
        setspeaker("Akie")
        msgbox(format("Two of them. Then a knife in the dark."))
        msgbox(format("And they want us to sit here and wait our turn."))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_BLACKOUT) {
        setspeaker("Akie")
        msgbox(format("Of course. Of course the lights go as well."))
        setspeaker(NULL)
        release
        end
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherAkie)
    }
    setspeaker("Akie")
    msgbox(format("Hah. Look at my husband.\pHe hasn't turned his head towards me once tonight."))
    msgbox(format("Go on. Ask him what he married me for.\pHe'll tell you. He tells everybody."))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_AKIE)) {
        setflag(FLAG_TARC3_DINNER_TALK_AKIE)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningTatsuo {
    lock
    faceplayer
    setspeaker("Tatsuo")
    msgbox(format("See that one? The artist?\pHe's been this family's charity case since he was ten."))
    msgbox(format("Sits there, drawing constantly.\pThe old man funded his education because he is Natsue's friend."))
    msgbox(format("I'm married to his granddaughter! I'm part of the family!\pWhy can't he 'invest' in me too?"))
    setspeaker(NULL)
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_TATSUO)) {
        setflag(FLAG_TARC3_DINNER_TALK_TATSUO)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningIchiro {
    lock
    faceplayer
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_TO_ELECTRICAL) {
        setspeaker("Ichiro")
        msgbox(format("Natsue bound it up. It looked worse than it was."))
        msgbox(format("I keep going back over it, trying to find something useful.\pThere's nothing there. It was dark, and then it wasn't."))
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_DiningIchiroEvidence)
    }
    if (var(VAR_TARC3_ACT2) >= TARC3_ACT2_GATHER) {
        goto(tarc3_MainDeck_EventScript_GatherIchiro)
    }
    setspeaker("Ichiro")
    msgbox(format("Oh. Sorry.\pI have been working on a new sketch."))
    msgbox(format("I stopped to wash my hands on the way.\pI love drawing with charcoal, but it can be messy."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("He glances down the table at Natsue, then back at his plate.", "1_latin_rse_narrow"))
    closemessage
    if (!flag(FLAG_TARC3_DINNER_TALK_ICHIRO)) {
        setflag(FLAG_TARC3_DINNER_TALK_ICHIRO)
        addvar(VAR_TARC3_DINNER_TALKED, 1)
    }
    goto(tarc3_MainDeck_EventScript_DinnerTalkDone)
}

script tarc3_MainDeck_EventScript_DiningIchiroEvidence {
    if (!flag(FLAG_TARC3_ICHIRO_FOUND_LIE)) {
        msgbox(format("{FONT_NARROW}Dark the whole time, by his own account. He never saw a single thing.", "1_latin_rse_narrow"))
        closemessage
        giveevidence(EVD_BATHROOM_BLACKOUT)
        closemessage
        setflag(FLAG_TARC3_ICHIRO_FOUND_LIE)
    }
    if (!flag(FLAG_TARC3_ICHIRO_FOUND_LEG)) {
        msgbox(format("{FONT_NARROW}The bandage is wrapped around his thigh.", "1_latin_rse_narrow"))
        msgbox(format("{FONT_NARROW}Not a cut on his palms. Nothing on his forearms either.", "1_latin_rse_narrow"))
        closemessage
        giveevidence(EVD_INJURED_LEG)
        giveevidence(EVD_NO_DEFENSIVE_WOUNDS)
        closemessage
        setflag(FLAG_TARC3_ICHIRO_FOUND_LEG)
    }
    release
    end
}

// CS7 (probably a better way to do this)

script tarc3_MainDeck_EventScript_DeckDoorFrom9 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_up * 2, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFrom10 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_up * 3, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFrom11 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_up * 4, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFrom12 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_up * 5, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFrom13 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_up * 6, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFromStairsA {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorFromStairsB {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down, face_left))
    goto(tarc3_MainDeck_EventScript_DeckDoorScene)
}

script tarc3_MainDeck_EventScript_DeckDoorScene {
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_MAINDECK_RAN_DECK, moves(face_right))
    waitmovement(0)
    delay(20)
    setspeaker("Natsue")
    msgbox(format("I married a man this morning, and now I don't know his name."))
    msgbox(format("Everyone down that corridor decided he was a killer immediately.\pMy aunt has him in a storage hold."))
    msgbox(format("...I left.\pI stood there and I left him."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_RAN_DECK, moves(face_up))
    setspeaker("{RIVAL}")
    msgbox(format("Not one person in that room proved anything.\pThey decided first, and went hunting for reasons afterwards."))
    msgbox(format("That garland was lying flat in the corridor, undamaged.\pAnyone walking past was certain to see it."))
    msgbox(format("What that means, I have not yet settled.\pBut it is the question not one of them thought to ask."))
    closemessage
    delay(20)
    playse(SE_PIN)
    applymovement(LOCALID_MAINDECK_NATSUE_DECK, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    setspeaker("Natsue")
    msgbox(format("Nonetheless, whoever did it... Is still on this ship with us."))
    setspeaker("{RIVAL}")
    delay(40)
    msgbox(format("Yes.\pThey are."))
    setspeaker(NULL)
    closemessage
    delay(40)
    playse(SE_M_DIVE)
    delay(50)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    applymovement(LOCALID_MAINDECK_RAN_DECK, moves(face_left))
    applymovement(LOCALID_MAINDECK_NATSUE_DECK, moves(face_left))
    waitmovement(0)
    delay(80)
    playse(SE_BANG)
    delay(80)
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("...What was that."))
    setspeaker("Natsue")
    msgbox(format("There were two sounds.\pA splash... and a thud."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}A splash on its own could be any water Pokémon outside.\pBut a loud thud on the deck afterwards..?", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_TWO_SOUNDS)
    closemessage
    delay(30)
    setspeaker("{RIVAL}")
    msgbox(format("Outside.\pGo and look. We are behind you."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_BODY_ON_DECK)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_TheScream {
    lockall
    delay(30)
    fadeoutbgm(2)
    delay(20)
    playse(SE_PIN)
    delay(20)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(face_left))
    applymovement(LOCALID_MAINDECK_NATSUE_DINING, moves(face_left))
    applymovement(LOCALID_MAINDECK_TAKESHI_DINING, moves(face_left))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("There is blood on the master's door!"))
    msgbox(format("Everyone come, quickly!"))
    setspeaker(NULL)
    closemessage
    delay(20)
    setflag(FLAG_HIDE_TARC3_DINING_JOJI)
    setflag(FLAG_HIDE_TARC3_DINING_NATSUE)
    setflag(FLAG_HIDE_TARC3_DINING_TAKESHI)
    setflag(FLAG_HIDE_TARC3_DINING_MARIKO)
    setflag(FLAG_HIDE_TARC3_DINING_KITARO)
    setflag(FLAG_HIDE_TARC3_DINING_AKIE)
    setflag(FLAG_HIDE_TARC3_DINING_TATSUO)
    setflag(FLAG_HIDE_TARC3_DINING_ICHIRO)
    setflag(FLAG_HIDE_TARC3_DINING_RAN)
    clearflag(FLAG_HIDE_TARC3_GOZO_SUZUKI)
    clearflag(FLAG_HIDE_TARC3_HALL_NATSUE)
    clearflag(FLAG_HIDE_TARC3_HALL_TAKESHI)
    clearflag(FLAG_HIDE_TARC3_HALL_JOJI)
    clearflag(FLAG_HIDE_TARC3_HALL_MARIKO)
    clearflag(FLAG_HIDE_TARC3_HALL_KITARO)
    clearflag(FLAG_HIDE_TARC3_HALL_ICHIRO)
    clearflag(FLAG_HIDE_TARC3_HALL_AKIE)
    clearflag(FLAG_HIDE_TARC3_HALL_TATSUO)
    setvar(VAR_TARC3_ACT1, TARC3_ACT1_THE_BODY)
    fadescreenspeed(FADE_TO_BLACK, 6)
    fwdtime(TARC3_TOD_EVENING_HOUR, TARC3_TOD_EVENING_MINUTE)
    pausefakertc
    warp(MAP_TARC3_GOZO_ROOM, 10, 11)
    waitstate
    end
}

// CS9 - investigation

script tarc3_MainDeck_EventScript_RoomSettles {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    waitmovement(0)
    delay(30)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_up * 2))
    waitmovement(0)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("We locked him in a room, and yet he still escaped.\pHe could be anywhere!"))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}I should use this time to talk to members of the family.", "1_latin_rse_narrow"))
    closemessage
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_GATHER)
    applymovement(LOCALID_CAMERA, moves(walk_down * 2))
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_GatherTalkDone {
    addvar(VAR_TARC3_GATHER_TALKED, 1)
    if (var(VAR_TARC3_GATHER_TALKED) == 3) {
        goto(tarc3_MainDeck_EventScript_IchiroExcusesHimself)
    }
    if (var(VAR_TARC3_GATHER_TALKED) >= 6) {
        goto(tarc3_MainDeck_EventScript_Blackout)
    }
    release
    end
}

script tarc3_MainDeck_EventScript_IchiroExcusesHimself {
    closemessage
    delay(30)
    applymovement(LOCALID_MAINDECK_ICHIRO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Ichiro")
    msgbox(format("Excuse me... I need to use the bathroom."))
    setspeaker(NULL)
    closemessage
    hidefollower
    delay(20)
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    if (var(VAR_TEMP_1) == 44 && var(VAR_TEMP_2) == 9) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right, face_left))
        waitmovement(0)
        delay(10)
    }
    applymovement(LOCALID_MAINDECK_ICHIRO_DINING, moves(walk_down * 2, walk_left * 16))
    waitmovement(0)
    updatefollowingmon
    setflag(FLAG_HIDE_TARC3_DINING_ICHIRO)
    removeobject(LOCALID_MAINDECK_ICHIRO_DINING)
    delay(20)
    release
    end
}

script tarc3_MainDeck_EventScript_GatherAkie {
    setspeaker("Akie")
    if (var(VAR_TARC3_GATHER_AKIE) == 0) {
        msgbox(format("None of this would have happened if she hadn't brought that man into this family."))
        msgbox(format("Natsue chose him.\pShe chose him, and now both my grandfather and my husband are dead."))
        setvar(VAR_TARC3_GATHER_AKIE, 1)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherTalkDone)
    }
    if (var(VAR_TARC3_GATHER_AKIE) == 1) {
        msgbox(format("And don't look at me as though I'm the only one in here counting."))
        msgbox(format("My aunt wanted her father's money more than any of us.\pShe has never once pretended otherwise."))
        setvar(VAR_TARC3_GATHER_AKIE, 2)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherTalkDone)
    }
    msgbox(format("Leave me alone. Please."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_GatherMariko {
    setspeaker("Mariko")
    if (var(VAR_TARC3_GATHER_MARIKO) == 0) {
        msgbox(format("Natsue had the most to gain and not one of them will say it out loud."))
        msgbox(format("All of it goes to her.\pEvery share, every property, every last dollar."))
        setvar(VAR_TARC3_GATHER_MARIKO, 1)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherTalkDone)
    }
    if (var(VAR_TARC3_GATHER_MARIKO) == 1) {
        msgbox(format("Before anybody asks me where I was this evening."))
        msgbox(format("Ask Akie who she's been seeing since the spring.\pAsk her whether Tatsuo knew."))
        setvar(VAR_TARC3_GATHER_MARIKO, 2)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherMarikoReflectEnd)
    }
    msgbox(format("I've said my piece."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_GatherMarikoReflectEnd {
    goto(tarc3_MainDeck_EventScript_GatherTalkDone)
}

script tarc3_MainDeck_EventScript_GatherKitaro {
    setvar(VAR_TEMP_4, 0)
    if (!flag(FLAG_TARC3_GATHER_KITARO)) {
        addvar(VAR_TEMP_4, 1)
    }
    if (!flag(FLAG_TARC3_GATHER_KITARO_TATSUO)) {
        addvar(VAR_TEMP_4, 1)
    }
    if (defeated(TRAINER_TARC3_KITARO) && !flag(FLAG_TARC3_KITARO_SMEARGLE)) {
        addvar(VAR_TEMP_4, 1)
    }
    if (var(VAR_TEMP_4) == 0) {
        goto(tarc3_MainDeck_EventScript_GatherKitaroExhausted)
    }
    setspeaker(NULL)
    message(format("{FONT_NARROW}What do I need from him?", "1_latin_rse_narrow"))
    waitmessage
    if (!flag(FLAG_TARC3_GATHER_KITARO)) {
        dynmultipush("Where everyone was", 1)
    }
    if (!flag(FLAG_TARC3_GATHER_KITARO_TATSUO)) {
        dynmultipush("Tatsuo", 2)
    }
    if (defeated(TRAINER_TARC3_KITARO) && !flag(FLAG_TARC3_KITARO_SMEARGLE)) {
        dynmultipush("How he spent the day", 3)
    }
    dynmultipush("Nothing", 4)
    dynmultistack(0, 0, FALSE, 4, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 1:
            goto(tarc3_MainDeck_EventScript_GatherKitaroCabins)
        case 2:
            goto(tarc3_MainDeck_EventScript_GatherKitaroTatsuo)
        case 3:
            goto(tarc3_MainDeck_EventScript_GatherKitaroSmeargle)
        case MULTI_B_PRESSED:
            goto(tarc3_MainDeck_EventScript_GatherKitaroExhausted)
        default:
            goto(tarc3_MainDeck_EventScript_GatherKitaroExhausted)
    }
}

script tarc3_MainDeck_EventScript_GatherKitaroExhausted {
    setspeaker("Kitaro")
    msgbox(format("Not one of us can account for the others.\pThat's the whole of it."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_GatherKitaroCabins {
    setspeaker("Kitaro")
    msgbox(format("After they found Father, we all went to our own cabins. Every one of us."))
    msgbox(format("That's where we were when Tatsuo... when it happened.\pNobody can vouch for anybody."))
    setspeaker(NULL)
    closemessage
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_up))
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("You went for a walk."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_KITARO_DINING, moves(face_up))
    waitmovement(0)
    setspeaker("Kitaro")
    msgbox(format("...I did."))
    applymovement(LOCALID_MAINDECK_KITARO_DINING, moves(face_down))
    waitmovement(0)
    msgbox(format("I needed time to clear my head.\pEven though Gozo is gone, would Mariko support me if I resigned?"))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_CAMERA, moves(walk_down))
    waitmovement(0)
    special(RemoveCameraObject)
    setflag(FLAG_TARC3_GATHER_KITARO)
    goto(tarc3_MainDeck_EventScript_GatherKitaroReflectEnd)
}

script tarc3_MainDeck_EventScript_GatherKitaroTatsuo {
    setspeaker("Kitaro")
    msgbox(format("Tatsuo and I were the same thing to this family.\pMarried in, and never once let to forget it."))
    msgbox(format("He decided early that if they were going to call him a parasite, he would be a very comfortable one."))
    msgbox(format("I decided the opposite. Twenty-two years of it."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}Two men married into the same family. One stopped trying. One never did.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_GATHER_KITARO_TATSUO)
    goto(tarc3_MainDeck_EventScript_GatherKitaroReflectEnd)
}

script tarc3_MainDeck_EventScript_GatherKitaroSmeargle {
    call(tarc3_MainDeck_EventScript_KitaroSmeargleBody)
    goto(tarc3_MainDeck_EventScript_GatherKitaroReflectEnd)
}

script tarc3_MainDeck_EventScript_DiningKitaroSmeargle {
    call(tarc3_MainDeck_EventScript_KitaroSmeargleBody)
    release
    end
}

script tarc3_MainDeck_EventScript_KitaroSmeargleBody {
    setspeaker("Kitaro")
    msgbox(format("Ichiro asked me for a battle, right as they were calling us in. He never asks."))
    msgbox(format("Odd sort of battle. He didn't attack once.\pHis Smeargle just kept dodging, until I hit it with a well-aimed Discharge."))
    msgbox(format("Then he thanked me and put his sketchbook back under his arm."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}Ichiro does not ask anyone for anything. And then he did not throw a single move.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_KITARO_SMEARGLE)
    giveevidence(EVD_THE_ODD_BATTLE)
    closemessage
    return
}

script tarc3_MainDeck_EventScript_GatherKitaroReflectEnd {
    goto(tarc3_MainDeck_EventScript_GatherTalkDone)
}


script tarc3_MainDeck_EventScript_GatherJoji {
    setspeaker("Joji")
    if (var(VAR_TARC3_GATHER_JOJI) == 0) {
        msgbox(format("Nobody in this room should be naming names."))
        msgbox(format("I've been in the galley or in my cabin all evening.\pI'm sure my knives haven't left their storage."))
        msgbox(format("Years ago, I asked Father for a loan. For my restaurant.\pIn response, he... bought me a cheap pair of knives."))
        msgbox(format("It's kind of ironic, now."))
        setvar(VAR_TARC3_GATHER_JOJI, 1)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherJojiReflectEnd)
    }
    if (var(VAR_TARC3_GATHER_JOJI) == 1) {
        msgbox(format("Poor Ichiro...\pFather told him on this ship that he was finished paying for that school.\pSaid it in the open, where people could hear."))
        msgbox(format("Tatsuo thought it was funny.\pHe said so to the boy's face."))
        msgbox(format("We shouldn't treat him as our plaything."))
        setvar(VAR_TARC3_GATHER_JOJI, 2)
        setspeaker(NULL)
        closemessage
        goto(tarc3_MainDeck_EventScript_GatherTalkDone)
    }
    msgbox(format("Let them shout. It'll pass."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_GatherJojiReflectEnd {
    goto(tarc3_MainDeck_EventScript_GatherTalkDone)
}

script tarc3_MainDeck_EventScript_GatherNatsue {
    if (flag(FLAG_TARC3_GATHER_NATSUE)) {
        setspeaker("Natsue")
        msgbox(format("Somebody opened that door.\pThat's the part none of them will look at."))
        setspeaker(NULL)
        release
        end
    }
    setspeaker("Natsue")
    msgbox(format("He was behind a bolted door."))
    msgbox(format("Whatever they've decided he is, he cannot have been in two places."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}That bolt only works from the outside. And nobody forced it.", "1_latin_rse_narrow"))
    closemessage
    setspeaker("Natsue")
    msgbox(format("Takeshi couldn't have let himself out.\pSomeone opened that door for him."))
    setspeaker(NULL)
    closemessage
    delay(20)
    call(tarc3_MainDeck_EventScript_GatherNatsuePanUp)
    delay(20)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("Or he had an accomplice."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Natsue")
    msgbox(format("We don't know where he is! He could be hurt!"))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Mariko")
    msgbox(format("Psh. If we should be so lucky..."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_right))
    waitmovement(0)
    setspeaker(NULL)
    delay(20)
    call(tarc3_MainDeck_EventScript_GatherNatsuePanDown)
    setflag(FLAG_TARC3_GATHER_NATSUE)
    goto(tarc3_MainDeck_EventScript_GatherNatsueReflect)
}

// Natsue can be spoken to from 38,12; 37,13 or 38,14 so the pan onto
// Mariko at (38,7) is measured from wherever the player is standing

script tarc3_MainDeck_EventScript_GatherNatsuePanUp {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_up * 2))
    waitmovement(0)
    if (var(VAR_0x8005) >= 13) {
        applymovement(LOCALID_CAMERA, moves(walk_up))
        waitmovement(0)
    }
    if (var(VAR_0x8005) >= 14) {
        applymovement(LOCALID_CAMERA, moves(walk_up))
        waitmovement(0)
    }
    return
}

script tarc3_MainDeck_EventScript_GatherNatsuePanDown {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8005) >= 14) {
        applymovement(LOCALID_CAMERA, moves(walk_down))
        waitmovement(0)
    }
    if (var(VAR_0x8005) >= 13) {
        applymovement(LOCALID_CAMERA, moves(walk_down))
        waitmovement(0)
    }
    applymovement(LOCALID_CAMERA, moves(walk_down * 2))
    waitmovement(0)
    special(RemoveCameraObject)
    return
}

script tarc3_MainDeck_EventScript_GatherNatsueReflect {
    goto_if_set(FLAG_TARC3_REFLECT_GATHER_NATSUE, tarc3_MainDeck_EventScript_GatherNatsueReflectEnd)
    setspeaker(NULL)
    message(format("{FONT_NARROW}Two different perspectives on Takeshi. What makes sense?", "1_latin_rse_narrow"))
    waitmessage
    dynmultipush("Natsue trusts him", 1)
    dynmultipush("Mariko says he had help", 2)
    dynmultipush("Nobody forced the bolt", 3)
    dynmultistack(0, 0, TRUE, 3, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 2:
            goto(tarc3_MainDeck_EventScript_GatherNatsueReflectAccomplice)
        default:
            goto(tarc3_MainDeck_EventScript_GatherNatsueReflectIrrelevant)
    }
}

script tarc3_MainDeck_EventScript_GatherNatsueReflectAccomplice {
    msgbox(format("{FONT_NARROW}Mariko is convinced of Takeshi's involvement. Is she suggesting he has an accomplice?", "1_latin_rse_narrow"))
    msgbox(format("{FONT_NARROW}Could she be right?", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_GATHER_NATSUE)
    giveevidence(EVD_AN_ACCOMPLICE)
    closemessage
    goto(tarc3_MainDeck_EventScript_GatherNatsueReflectEnd)
}

script tarc3_MainDeck_EventScript_GatherNatsueReflectIrrelevant {
    msgbox(format("{FONT_NARROW}I already know that much. It's not what I need from her.", "1_latin_rse_narrow"))
    closemessage
    setflag(FLAG_TARC3_REFLECT_GATHER_NATSUE)
    goto(tarc3_MainDeck_EventScript_GatherNatsueReflectEnd)
}

script tarc3_MainDeck_EventScript_GatherNatsueReflectEnd {
    goto(tarc3_MainDeck_EventScript_GatherTalkDone)
}

script tarc3_MainDeck_EventScript_GatherSuzuki {
    setspeaker("Suzuki")
    if (flag(FLAG_TARC3_GATHER_SUZUKI)) {
        msgbox(format("I bolted that door. I will not pretend otherwise to make this easier."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("Thirty-one years I have kept this family's doors.\pTonight I put a man behind one."))
    msgbox(format("The others will tell you what they believe.\pI can only tell you what I did, and I drew that bolt myself."))
    msgbox(format("I also carry every key aboard this ship.\pIf you mean to ask who could have gone where tonight, begin with me."))
    setspeaker(NULL)
    closemessage
    setflag(FLAG_TARC3_GATHER_SUZUKI)
    goto(tarc3_MainDeck_EventScript_GatherTalkDone)
}

script tarc3_MainDeck_EventScript_GatherIchiro {
    setspeaker("Ichiro")
    if (flag(FLAG_TARC3_GATHER_ICHIRO)) {
        msgbox(format("...Sorry. I'm not much use tonight."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("Oh. Sorry. I'm finding it hard to focus."))
    msgbox(format("I... I just want to sleep. And be home."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Ichiro")
    msgbox(format("It's not easy to make art in this room."))
    setspeaker(NULL)
    closemessage
    setflag(FLAG_TARC3_GATHER_ICHIRO)
    goto(tarc3_MainDeck_EventScript_GatherTalkDone)
}

// CS10

script tarc3_MainDeck_EventScript_BlackoutPanToSpeakers {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) < 47 && var(VAR_0x8005) < 13) {
        return
    }
    special(SpawnCameraObject)
    if (var(VAR_0x8004) >= 47) {
        applymovement(LOCALID_CAMERA, moves(walk_faster_left * 6))
        waitmovement(0)
    }
    if (var(VAR_0x8005) >= 13) {
        applymovement(LOCALID_CAMERA, moves(walk_faster_up * 4))
        waitmovement(0)
    }
    return
}

script tarc3_MainDeck_EventScript_BlackoutRestoreCamera {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) < 47 && var(VAR_0x8005) < 13) {
        return
    }
    if (var(VAR_0x8005) >= 13) {
        applymovement(LOCALID_CAMERA, moves(walk_faster_down * 4))
        waitmovement(0)
    }
    if (var(VAR_0x8004) >= 47) {
        applymovement(LOCALID_CAMERA, moves(walk_faster_right * 6))
        waitmovement(0)
    }
    special(RemoveCameraObject)
    return
}

script tarc3_MainDeck_EventScript_Blackout {
    closemessage
    lockall
    delay(30)
    call(tarc3_MainDeck_EventScript_BlackoutPanToSpeakers)
    applymovement(LOCALID_MAINDECK_KITARO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Kitaro")
    msgbox(format("Hmm. Ichiro has been gone a long while now."))
    msgbox(format("I think someone should be with him."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}He's been out of this room a lot longer than a wash takes.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_LONG_ABSENCE)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_MARIKO_DINING, moves(face_down))
    waitmovement(0)
    setspeaker("Mariko")
    msgbox(format("And Takeshi could be anywhere!"))
    setspeaker(NULL)
    closemessage
    delay(30)
    fadescreenswapbuffers(FADE_TO_BLACK)
    playse(SE_M_THUNDERBOLT2)
    waitse
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox(format("{FONT_NARROW}The lights!", "1_latin_rse_narrow"))
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    fadescreen(FADE_TO_BLACK)
    overridetodblend(TARC3_TOD_BLACKOUT)
    call(tarc3_MainDeck_EventScript_BlackoutRestoreCamera)
    delay(30)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_BLACKOUT)
    warp(MAP_TARC3_BATHROOM, 7, 8)
    waitstate
    end
}

script tarc3_MainDeck_EventScript_BlackoutReturn {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down * 2, walk_left, face_left))
    waitmovement(0)
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("{PLAYER} Edgeworth. With me.\pWe will see to him."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_SUZUKI_DINING, moves(face_up))
    waitmovement(0)
    setspeaker("Suzuki")
    msgbox(format("I'll inspect the power breaker downstairs."))
    setspeaker(NULL)
    closemessage
    delay(20)
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(walk_up * 3, walk_left * 4, face_left))
    waitmovement(0)
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("The bathrooms are at the far end of the corridor.\pStay close to me."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_LEAVING_DINING)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_SuzukiLeaves {
    lockall
    applymovement(LOCALID_MAINDECK_SUZUKI_DINING, moves(walk_up * 6, walk_left, walk_up))
    waitmovement(0)
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(face_left))
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_TARC3_DINING_SUZUKI)
    removeobject(LOCALID_MAINDECK_SUZUKI_DINING)
    delay(30)
    setspeaker("{RIVAL}")
    msgbox(format("He will be some minutes."))
    msgbox(format("This way, {PLAYER} Edgeworth."))
    setspeaker(NULL)
    closemessage
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(walk_left * 5))
    waitmovement(0)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_SUZUKI_BELOW)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_Scream {
    lockall
    playse(SE_M_CUT)
    delay(60)
    msgbox(format("{FONT_NARROW}That came from the bathrooms!", "1_latin_rse_narrow"))
    closemessage
    setspeaker("{RIVAL}")
    msgbox(format("Ichiro!"))
    setspeaker(NULL)
    closemessage
    applymovement(LOCALID_MAINDECK_RAN_DINING, moves(walk_fast_left * 8))
    waitmovement(0)
    setflag(FLAG_HIDE_TARC3_DINING_RAN)
    removeobject(LOCALID_MAINDECK_RAN_DINING)
    clearflag(FLAG_HIDE_TARC3_CORRIDOR_RAN)
    setvar(VAR_TARC3_ACT2, TARC3_ACT2_TO_BATHROOM)
    releaseall
    end
}

script tarc3_MainDeck_EventScript_ScreamNoExitDeck {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
    waitmovement(0)
    msgbox(format("{FONT_NARROW}That came from the bathrooms. I need to get there right away.", "1_latin_rse_narrow"))
    releaseall
    end
}

script tarc3_MainDeck_EventScript_ScreamNoExitStairs {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down))
    waitmovement(0)
    msgbox(format("{FONT_NARROW}That came from the bathrooms. I need to get there right away.", "1_latin_rse_narrow"))
    releaseall
    end
}

script tarc3_MainDeck_EventScript_BlackoutNoExitHold {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down))
    waitmovement(0)
    msgbox(format("{FONT_NARROW}Suzuki has gone downstairs. I need to get to the bathrooms.", "1_latin_rse_narrow"))
    releaseall
    end
}

script tarc3_MainDeck_EventScript_CorridorRan {
    lock
    faceplayer
    setspeaker("{RIVAL}")
    msgbox(format("Go in, {PLAYER} Edgeworth."))
    msgbox(format("I will hold this corridor and bring the others to you."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_GatherNoExit {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
    waitmovement(0)
    msgbox(format("{FONT_NARROW}Nobody is leaving this room while they're still going at each other.\pI should hear the rest of it.", "1_latin_rse_narrow"))
    releaseall
    end
}

// ACT THREE
// player finds sketchbook & unlocks this dialogue

script tarc3_MainDeck_EventScript_SuzukiSearch {
    if (flag(FLAG_TARC3_SUZUKI_SEARCH_TALKED)) {
        goto(tarc3_MainDeck_EventScript_SuzukiSearchAgain)
    }
    setspeaker("Suzuki")
    msgbox(format("I have kept them all in this room, {PLAYER}.\pThe cabin doors are all unlocked."))
    setspeaker(NULL)
    closemessage
    setvar(VAR_TEMP_4, 0)
    setvar(VAR_TEMP_5, 0)
    goto(tarc3_MainDeck_EventScript_SuzukiSearchTopics)
}

script tarc3_MainDeck_EventScript_SuzukiSearchAgain {
    if (flag(FLAG_TARC3_CABIN_FOUND_SKETCHBOOK) && !flag(FLAG_TARC3_REFLECT_SUZUKI_SUITOR)) {
        setspeaker("Suzuki")
        msgbox(format("Was there something else, {PLAYER}?"))
        setspeaker(NULL)
        closemessage
        setvar(VAR_TEMP_4, 1)
        setvar(VAR_TEMP_5, 1)
        goto(tarc3_MainDeck_EventScript_SuzukiSearchTopics)
    }
    setspeaker("Suzuki")
    msgbox(format("Every cabin door is open to you.\pFind him, and I will keep the rest of them where they are."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_SuzukiSearchTopics {
    if (var(VAR_TEMP_4) == 1 && var(VAR_TEMP_5) == 1) {
        if (!flag(FLAG_TARC3_CABIN_FOUND_SKETCHBOOK) || flag(FLAG_TARC3_REFLECT_SUZUKI_SUITOR)) {
            setflag(FLAG_TARC3_SUZUKI_SEARCH_TALKED)
            goto(tarc3_MainDeck_EventScript_SuzukiSearchEnd)
        }
    }
    setspeaker(NULL)
    message(format("{FONT_NARROW}What do I need from him?", "1_latin_rse_narrow"))
    waitmessage
    if (var(VAR_TEMP_4) == 0) {
        dynmultipush("Where Takeshi is", 1)
    }
    if (var(VAR_TEMP_5) == 0) {
        dynmultipush("Your years of service", 2)
    }
    if (flag(FLAG_TARC3_CABIN_FOUND_SKETCHBOOK) && !flag(FLAG_TARC3_REFLECT_SUZUKI_SUITOR)) {
        dynmultipush("Natsue's secret suitor", 3)
    }
    dynmultipush("Nothing", 4)
    dynmultistack(0, 0, FALSE, 4, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 1:
            goto(tarc3_MainDeck_EventScript_SuzukiSearchTakeshi)
        case 2:
            goto(tarc3_MainDeck_EventScript_SuzukiSearchService)
        case 3:
            goto(tarc3_MainDeck_EventScript_SuzukiSuitor)
        case MULTI_B_PRESSED:
            goto(tarc3_MainDeck_EventScript_SuzukiSearchEnd)
        default:
            goto(tarc3_MainDeck_EventScript_SuzukiSearchEnd)
    }
}

script tarc3_MainDeck_EventScript_SuzukiSearchTakeshi {
    setvar(VAR_TEMP_4, 1)
    setspeaker("Suzuki")
    msgbox(format("Takeshi is aboard. He must be.\pThere is nowhere else for him to hide."))
    msgbox(format("I have unlocked all cabin doors. You may investigate without interruption."))
    setspeaker(NULL)
    closemessage
    delay(20)
    goto(tarc3_MainDeck_EventScript_SuzukiSearchTopics)
}

script tarc3_MainDeck_EventScript_SuzukiSearchService {
    setvar(VAR_TEMP_5, 1)
    setspeaker("Suzuki")
    msgbox(format("Thirty-one years with the master.\pI have carried his letters, his accounts and his moods."))
    msgbox(format("A man tells his valet things he would not tell his own family.\pI have never repeated one of them."))
    setspeaker(NULL)
    closemessage
    delay(20)
    msgbox(format("{FONT_NARROW}...He is telling me he knows more than he has said.", "1_latin_rse_narrow"))
    closemessage
    delay(20)
    goto(tarc3_MainDeck_EventScript_SuzukiSearchTopics)
}

script tarc3_MainDeck_EventScript_SuzukiSuitor {
    delay(40)
    playse(SE_PIN)
    applymovement(LOCALID_MAINDECK_SUZUKI_DINING, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(30)
    setspeaker("Suzuki")
    msgbox(format("Ichiro approaching Gozo to ask for Natsue's hand?"))
    msgbox(format("...How could you possibly know that?"))
    msgbox(format("There was only one person Master Gozo felt he could share that with. Me."))
    setspeaker(NULL)
    closemessage
    delay(20)
    setspeaker("Suzuki")
    msgbox(format("Yes. It happened."))
    msgbox(format("A few weeks before the engagement to Takeshi was announced.\pThe master refused. Very harshly."))
    setspeaker(NULL)
    closemessage
    delay(30)
    msgbox(format("{FONT_NARROW}Ichiro's wedding invitation wasn't graciousness. It was calculated, silent torture.", "1_latin_rse_narrow"))
    closemessage
    giveevidence(EVD_REFUSED_SUITOR)
    closemessage
    setflag(FLAG_TARC3_REFLECT_SUZUKI_SUITOR)
    delay(20)
    goto(tarc3_MainDeck_EventScript_SuzukiSearchTopics)
}

script tarc3_MainDeck_EventScript_SuzukiSearchEnd {
    setspeaker("Suzuki")
    msgbox(format("Go, {PLAYER}."))
    setspeaker(NULL)
    release
    end
}

script tarc3_MainDeck_EventScript_DiningRanAct3 {
    setspeaker("{RIVAL}")
    if (!flag(FLAG_TARC3_CABIN_FOUND_TAKESHI)) {
        msgbox(format("The steward has unlocked every cabin door.\pTakeshi is behind one of them. There is nowhere else on this ship he can be."))
        msgbox(format("Find him, {PLAYER} Edgeworth.\pWhatever that man has or has not done, this ends the moment we have him."))
        setspeaker(NULL)
        release
        end
    }
    msgbox(format("You have found him. It is written all over you."))
    msgbox(format("Akie's cabin. Of course.\pSince Tatsuo died she has had no reason whatsoever to go in there."))
    closemessage
    delay(20)
    setspeaker("{RIVAL}")
    msgbox(format("Are you prepared to put this in front of all of them?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Then go back over it.\pOnce I have them assembled, there is no second attempt."))
        setspeaker(NULL)
        release
        end
    }
    setspeaker("{RIVAL}")
    msgbox(format("I will collect them."))
    setspeaker(NULL)
    closemessage
    delay(30)
    setvar(VAR_TARC3_ACT3, TARC3_ACT3_GATHERING)
    setflag(FLAG_HIDE_TARC3_DINING_ICHIRO_HURT)
    setflag(FLAG_HIDE_TARC3_DINING_RAN)
    setflag(FLAG_HIDE_TARC3_DINING_NATSUE)
    setflag(FLAG_HIDE_TARC3_DINING_KITARO)
    setflag(FLAG_HIDE_TARC3_DINING_MARIKO)
    setflag(FLAG_HIDE_TARC3_DINING_AKIE)
    setflag(FLAG_HIDE_TARC3_DINING_JOJI)
    setflag(FLAG_HIDE_TARC3_DINING_SUZUKI)
    clearflag(FLAG_HIDE_TARC3_CABIN_CAST)
    clearflag(FLAG_HIDE_TARC3_CABIN_RAN)
    fadescreenspeed(FADE_TO_BLACK, 6)
    warp(MAP_TARC3_CABINS, 19, 6)
    waitstate
    end
}
